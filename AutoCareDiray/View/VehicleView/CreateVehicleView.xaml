<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit" 
             xmlns:models="clr-namespace:AutoCareDiray.Shared.Models.RepairModel;assembly=AutoCareDiray.Shared"
             x:Class="AutoCareDiray.View.VehicleView.CreateVehicleView"
             Style="{StaticResource CustomPage}">

    <Shell.TitleView>
        <HorizontalStackLayout VerticalOptions="Center">
            <Label Text="Создание авто" Style="{DynamicResource LabelCustomPage}" />
        </HorizontalStackLayout>
    </Shell.TitleView>

    <ScrollView >

        <VerticalStackLayout Padding="20" Spacing="0">

            <VerticalStackLayout Spacing="10" Margin="0,10,0,25">
                <Border Style="{StaticResource BorderPhotoRound}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding PickPhotoCommand}"/>
                    </Border.GestureRecognizers>
                    <Image Source="{Binding PathPhoto}" Style="{DynamicResource ImageAddPhoto}" />
                </Border>
                <Label Text="Нажмите, чтобы добавить фото" Style="{DynamicResource LabelFunctionInfo}"/>
            </VerticalStackLayout>
            <!--Добавление фото авто-->

            <Label Text="Общая информация" Style="{DynamicResource LabelCustomMain}" Margin="5,0,0,10"/>

            <Border Style="{DynamicResource BorderForEntryCard}">
                <VerticalStackLayout Spacing="15">

                    <VerticalStackLayout>
                        <Label Text="Название ТС" Style="{StaticResource LabelInfoForEntry}"/>
                        <Entry Text="{Binding NameVehicle}" Placeholder="Например, Моя BMW" Style="{DynamicResource EntryImput}" />
                        <Label Text="{Binding NameVehicleError}" IsVisible="{Binding IsNameVehicleError}" Style="{DynamicResource LabelError}"/>
                    </VerticalStackLayout>
                    <!--название ТС-->

                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="auto,auto">
                        <Label Grid.Column="0" Text="Год выпуска" Style="{StaticResource LabelInfoForEntry}" VerticalOptions="Center"/>
                        <DatePicker Grid.Column="1" Format="M.yyyy" Date="{Binding YearPurchaseSelected}" VerticalOptions="Center" />
                        <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding YearPurchaseError}" Style="{DynamicResource LabelError}" IsVisible="{Binding IsYearPurchaseError}"/>
                    </Grid>
                    <!--дата-->

                </VerticalStackLayout>
            </Border>
            <!--Название ТС дата-->

            <Border Style="{DynamicResource BorderForEntryCard}">
                <VerticalStackLayout Spacing="15">

                    <VerticalStackLayout>
                        <Label Text="{Binding MileageText}" Style="{DynamicResource LabelInfoForEntry}"/>
                        <Grid ColumnDefinitions="*,*">
                            
                            <Entry Grid.Column="0" Text="{Binding Mileage , StringFormat='{0:N0}'}" Placeholder="0" Keyboard="Numeric" Style="{DynamicResource EntryImput}"/>
                            
                            <Picker Grid.Column="1" Style="{DynamicResource PickerStandart}" ItemsSource="{Binding UnitDistances}"
                                     SelectedItem="{Binding SelectedUnitDistance}"
                                    HorizontalTextAlignment="Center" WidthRequest="150">
                            </Picker>
                            
                        </Grid>
                        <Label Text="{Binding MileageError}" IsVisible="{Binding IsMileageError}" Style="{DynamicResource LabelError}"/>
                    </VerticalStackLayout> <!--пробег-->

                    <VerticalStackLayout >
                        <Label Text="{Binding FuelTankText}" Style="{DynamicResource LabelInfoForEntry}"/>
                        <Grid ColumnDefinitions="*,*">

                            <Entry Grid.Column="0" Text="{Binding FuelTank , StringFormat='{0:N0}'}" Placeholder="0" Keyboard="Numeric" Style="{DynamicResource EntryImput}"/>

                            <Picker Grid.Column="1" Style="{DynamicResource PickerStandart}" ItemsSource="{Binding UnitVolumes}"
                                    SelectedItem="{Binding SelectedUnitVolume}"
                                    HorizontalTextAlignment="Center" WidthRequest="150">

                            </Picker>
                        </Grid>
                        <Label Text="{Binding FuelTankError}" IsVisible="{Binding IsFuelTankError}" Style="{DynamicResource LabelError}"/>
                    </VerticalStackLayout>
                    <!--литры в баке-->

                    <VerticalStackLayout>
                        <Label Text="Тип транспортного средства" Style="{DynamicResource LabelInfoForEntry}"/>
                        <HorizontalStackLayout Spacing="5" RadioButtonGroup.GroupName="VehicleType" RadioButtonGroup.SelectedValue="{Binding SelectedTypeVehicle}">
                            <RadioButton Content="Авто" Value="Автомобиль" Style="{StaticResource RadioButtonCustom}"/>
                            <RadioButton Content="Мото" Value="Мотоцикл" Style="{StaticResource RadioButtonCustom}"/>
                            <RadioButton Content="Другое" Value="Другое" Style="{StaticResource RadioButtonCustom}"/>
                        </HorizontalStackLayout>
                        <Label Style="{DynamicResource LabelError}" Text="{Binding TypeVehicleError}" IsVisible="{Binding IsTypeVehicleError}"/>
                    </VerticalStackLayout>
                    <!--тип тс-->

                </VerticalStackLayout>
            </Border>
            <!--пробег литры и тип ТС-->

            <toolkit:Expander Margin="0,0,0,25">
                <toolkit:Expander.Header>
                    <Border Style="{StaticResource BorderForExpanderAddInfo}" Margin="0">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="Дополнительная информация (VIN, Гос. номер)" Style="{DynamicResource LabelInfoForEntry}"/>
                            <Label Grid.Column="1" Text="▼" Style="{DynamicResource LabelArrowDown}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding Source={RelativeSource AncestorType={x:Type toolkit:Expander}}, Path=IsExpanded}" Value="True">
                                        <Setter Property="Rotation" Value="180" />
                                        <Setter Property="TextColor" Value="{DynamicResource PrimaryGold}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Grid>
                    </Border>
                </toolkit:Expander.Header>

                <toolkit:Expander.Content>
                    <Border Style="{DynamicResource BorderForEntryCard}" Padding="20,5,20,20" Margin="0,-10,0,0">
                        <VerticalStackLayout Spacing="15">

                            <VerticalStackLayout>
                                <Label Text="VIN Код" Style="{DynamicResource LabelInfoForEntry}"/>
                                <Entry Text="{Binding VinCode}" Placeholder="17 символов" Keyboard="Text" Style="{DynamicResource EntryImput}"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout>
                                <Label Text="Гос. номер" Style="{DynamicResource LabelInfoForEntry}"/>
                                <Entry Text="{Binding StateNumber}" Placeholder="А000АА 00" Keyboard="Text" Style="{DynamicResource EntryImput}"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout>
                                <Label Text="Выберите коробку передач" Style="{DynamicResource LabelInfoForEntry}"/>
                                <HorizontalStackLayout Spacing="20" RadioButtonGroup.GroupName="Transmission" RadioButtonGroup.SelectedValue="{Binding TransmissionType, Mode=TwoWay}">
                                    <RadioButton Content="МКПП" Value="Механическая" Style="{DynamicResource RadioButtonCustom}"/>
                                    <RadioButton Content="АКПП" Value="Автоматическая" Style="{DynamicResource RadioButtonCustom}"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </Border>
                </toolkit:Expander.Content>
            </toolkit:Expander>

            <Label Text="{Binding StatusMessage}" Style="{DynamicResource LabelError}"/>

            <Button Text="{Binding ButtonName}" 
                    Style="{StaticResource ButtonCustomStandart}"
                    Command="{Binding ProcessingCommand}"
                    Margin="0,0,0,30"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>