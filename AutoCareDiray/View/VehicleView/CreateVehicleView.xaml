<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit" 
             xmlns:models="clr-namespace:AutoCareDiray.Shared.Models.RepairModel;assembly=AutoCareDiray.Shared"
             x:Class="AutoCareDiray.View.VehicleView.CreateVehicleView"
             Style="{StaticResource CustomPage}">

    <ScrollView>
        <VerticalStackLayout>
            <VerticalStackLayout Spacing="15" Padding="20">

                <Label Text="Общая информация" FontAttributes="Bold" FontSize="18" Margin="0,10,0,0"
                       Style="{DynamicResource LabelCustom}" HorizontalOptions="Center"/> <!--Общая информация-->

                <Border Style="{DynamicResource BorderForEntryImput}">
                    <Entry Style="{DynamicResource EntryImput}" Placeholder="Название ТС (например, Моя BMW)" 
                           Text="{Binding NameVehicle}"/>
                </Border> <!--NameVehicle-->

                <Border Style="{DynamicResource BorderForEntryImput}">
                    <VerticalStackLayout>
                        <Label Text="Выберите дату производства авто"
                               Style="{DynamicResource LabelPlaceholder}"/>
                        <DatePicker Format="d" Date="{Binding YearCreateSelected}" MaximumDate="{Binding DateNow}" />
                    </VerticalStackLayout>
                </Border> <!--YearCreate-->

                <Border Style="{DynamicResource BorderForEntryImput}">
                    
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsYearPurchaseError}" Value="False">
                            <Setter Property="Stroke" Value="{DynamicResource CardBorder}" />
                        </DataTrigger>

                        <DataTrigger TargetType="Border" Binding="{Binding IsYearPurchaseError}" Value="True">
                            <Setter Property="Stroke" Value="{DynamicResource StatusOverdue}"/>
                        </DataTrigger>
                    </Border.Triggers>
                    
                    <VerticalStackLayout>
                        <Label Text="Выберите дату покупки авто" Style="{DynamicResource LabelPlaceholder}"/>
                        <DatePicker Format="d" Date="{Binding YearPurchaseSelected}" MaximumDate="{Binding DateNow}" />
                        <Label Text="{Binding YearPurchaseError}" Style="{DynamicResource LabelError}" 
                               IsVisible="{Binding IsYearPurchaseError}"/>
                    </VerticalStackLayout>
                </Border> <!--YearPurchase-->

                <Border Style="{DynamicResource BorderForEntryImput}">
                    <Entry Style="{DynamicResource EntryImput}" Placeholder="Вин код авто (По желанию)" 
                           Text="{Binding VinCode}" Keyboard="Text"/>
                </Border> <!--VinCode-->

                <Border Style="{DynamicResource BorderForEntryImput}">
                    <Entry Style="{DynamicResource EntryImput}" Placeholder="Гос номер авто (По желанию)" 
                           Text="{Binding StateNumber}" Keyboard="Text"/>
                </Border> <!--StateNumber-->

                <Border Style="{DynamicResource BorderForEntryImput}">

                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsMileageError}" Value="False">
                            <Setter Property="Stroke" Value="{DynamicResource CardBorder}" />
                        </DataTrigger>

                        <DataTrigger TargetType="Border" Binding="{Binding IsMileageError}" Value="True">
                            <Setter Property="Stroke" Value="{DynamicResource StatusOverdue}"/>
                        </DataTrigger>
                    </Border.Triggers>

                    <VerticalStackLayout>
                        <Entry Style="{DynamicResource EntryImput}" Placeholder="Текущий пробег" 
                               Text="{Binding Mileage}" Keyboard="Numeric"/>
                        <Label Text="{Binding MileageError}" Style="{DynamicResource LabelError}"
                               IsVisible="{Binding IsMileageError}"/>
                    </VerticalStackLayout>
                </Border> <!--Mileage-->

                <Border Style="{DynamicResource BorderForEntryImput}">

                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsTypeVehicleError}" Value="False">
                            <Setter Property="Stroke" Value="{DynamicResource CardBorder}" />
                        </DataTrigger>

                        <DataTrigger TargetType="Border" Binding="{Binding IsTypeVehicleError}" Value="True">
                            <Setter Property="Stroke" Value="{DynamicResource StatusOverdue}"/>
                        </DataTrigger>
                    </Border.Triggers>
                    
                    <VerticalStackLayout>
                        <Label Style="{DynamicResource LabelPlaceholder}" Text="Выберите тип вашего ТС"/>
                        <Grid ColumnDefinitions="*,*" RowDefinitions="*,*" RadioButtonGroup.GroupName="VehicleType"
                              RadioButtonGroup.SelectedValue="{Binding SelectedTypeVehicle}">
                            <RadioButton  Grid.Column="0" Grid.Row="0" Content="Автомобиль" 
                                          Value="Автомобиль" Margin="15,0,0,0"/>

                            <RadioButton Grid.Column="1" Grid.Row="0" 
                                         Content="Мотоцикл" Value="Мотоцикл" Margin="15,0,0,0" />

                            <RadioButton Grid.Column="0" Grid.Row="1"  
                                         Content="Другое" Value="Другое" Margin="15,0,0,0"/>
                        </Grid>
                        <Label Style="{DynamicResource LabelError}" Text="{Binding TypeVehicleError}"
                               IsVisible="{Binding IsTypeVehicleError}"/>
                    </VerticalStackLayout>
                </Border> <!--VehicleType-->

                <BoxView HeightRequest="1" Color="#E0E0E0" Margin="0,10"/>

                <Label Text="Регламент обслуживания" FontAttributes="Bold" FontSize="18"
                       Style="{DynamicResource LabelCustom}" HorizontalOptions="Center"/> <!--Регламент обслуживания текст-->
                <Label Text="Отметьте, что вы уже заменили недавно. Остальное приложение предложит заменить само. Или же можете отметить что авто полностью обслужено" 
                       Style="{DynamicResource LabelSecondaryCustom}"
                       FontSize="12" Margin="0,0,0,10"
                       HorizontalOptions="Center"/>

                <Button Text="Авто полностью обслужено"
                        HorizontalOptions="Center"
                        Style="{DynamicResource ButtonCustomStandartRed}"
                        Command="{Binding ChangeIsServicedCommand}"
                        Margin="0,0,0,10"/> <!--Изменение обслужено авто или нет-->

                <Border Style="{DynamicResource BorderForEntryImput}">

                    <VerticalStackLayout>
                        <Label Style="{DynamicResource LabelPlaceholder}" Text="Выберите тип вашей коробки"
                               HorizontalOptions="Center"/>
                        <Grid RowDefinitions="auto,auto" HorizontalOptions="Center"
                              RadioButtonGroup.GroupName="Transmission"
                              RadioButtonGroup.SelectedValue="{Binding TransmissionType}">
                            <RadioButton  Grid.Row="0" Content="Механическая (МКПП)" Value="Механическая"/>

                            <RadioButton Grid.Row="1" Content="Автоматическая(АКПП)" Value="Автоматическая"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
                <!--TransmissionType-->

                <Border Style="{DynamicResource BorderForEntryImput}"
                        Padding="5"
                        Margin="0,10,0,0">
                    <Picker Title="Выберите категорию...  ▼" ItemsSource="{Binding RepairGrouped}" 
                            ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding SelectedGroup}"
                            FontAttributes="Bold" HorizontalOptions="Center"/>
                </Border> <!--Picker типов ремонта-->

            </VerticalStackLayout>

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding SelectedGroup}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:RepairType">

                        <Grid BackgroundColor="White" 
                                  Margin="20,4,20,4" 
                                  Padding="15"
                                  HeightRequest="75" 
                                  RowDefinitions="*, *" 
                                  ColumnDefinitions="*, 80">

                            <Label Text="{Binding TitleRepair}" Grid.Row="0" Grid.Column="0" VerticalOptions="Center" FontSize="14" FontAttributes="Bold" LineBreakMode="TailTruncation"/>

                            <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*, Auto" ColumnSpacing="3">
                                <Entry Text="{Binding IntervalMileage}" Grid.Column="0" Keyboard="Numeric" HeightRequest="36" HorizontalTextAlignment="Center"/>
                                <Label Text="км" Grid.Column="1" VerticalOptions="Center" FontSize="11" TextColor="Gray"/>
                            </Grid>

                            <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Spacing="15" Margin="0,5,0,0">
                                <HorizontalStackLayout Spacing="2">
                                    <CheckBox IsChecked="{Binding IsServiced}" Color="Red" Scale="0.8"/>
                                    <Label Text="Обслужено" VerticalOptions="Center" FontSize="12"/>
                                </HorizontalStackLayout>

                                <HorizontalStackLayout Spacing="2">
                                    <CheckBox IsChecked="{Binding IsRemoveMaintenance}" Color="Red" Scale="0.8"/>
                                    <Label Text="Не нужно" VerticalOptions="Center" FontSize="12"/>
                                </HorizontalStackLayout>
                            </HorizontalStackLayout>

                        </Grid>

                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <VerticalStackLayout Padding="20,15,20,40">
                <Label Text="{Binding StatusMessage}" Style="{DynamicResource LaberError}" HorizontalTextAlignment="Center" Margin="0,0,0,10"/>
                <Button Text="{Binding ButtonName}" 
                            Style="{StaticResource ButtonCustomStandartRed}"
                            Command="{Binding CreateVehicleCommand}"/>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>