<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit" 
             xmlns:models="clr-namespace:AutoCareDiray.Shared.Models.RepairModel;assembly=AutoCareDiray.Shared"
             x:Class="AutoCareDiray.View.VehicleView.CreateVehicleView"
             Style="{StaticResource CustomPage}">

    <ScrollView>
        <VerticalStackLayout>
            
            <VerticalStackLayout Spacing="15" Padding="15">

                <Label Text="Общая информация" FontSize="18" Margin="0,10,0,0" Style="{DynamicResource LabelCustom}" 
                       HorizontalOptions="Center"/>
                <!--Общая информация-->
                
                <Border Style="{DynamicResource BorderForEntryCard}">
                    
                    <VerticalStackLayout Spacing="0">

                        <VerticalStackLayout Padding="15,10">

                            <Label Text="Фотография вашего авто" Style="{DynamicResource LabelInfoForEntry}" HorizontalOptions="Center"/>
                            
                            <Border Style="{DynamicResource BorderPhoto}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding PickPhotoCommand}"/>
                                </Border.GestureRecognizers>

                                <Image Source="{Binding PathPhoto}" HeightRequest="250" WidthRequest="250" TranslationY="10"/>
                            </Border>
                        </VerticalStackLayout> <!--Photo-->

                        <BoxView Style="{DynamicResource BoxViewCustom}"/>

                        <VerticalStackLayout Padding="15,10">
                            <Label Text="Название ТС (например, Моя BMW)" Style="{DynamicResource LabelInfoForEntry}"/>
                            <Entry Text="{Binding NameVehicle}" Placeholder="Например, Моя BMW" Style="{DynamicResource EntryImput}" />
                            <Label Text="{Binding NameVehicleError}" IsVisible="{Binding IsNameVehicleError}" Style="{DynamicResource LabelError}"/>
                        </VerticalStackLayout> <!--NameVehicle-->

                        <BoxView Style="{DynamicResource BoxViewCustom}"/>

                        <Grid ColumnDefinitions="*, Auto" RowDefinitions="auto,auto" Padding="15,10">
                            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                <Label Text="Год покупки ТС" Style="{DynamicResource LabelInfoForEntry}"/>
                            </VerticalStackLayout>

                            <DatePicker Grid.Column="1" Format="M.yyyy" Date="{Binding YearPurchaseSelected}" VerticalOptions="Center" />
                            <Label Grid.Row="1" Text="{Binding YearPurchaseError}" Style="{DynamicResource LabelError}" 
           IsVisible="{Binding IsYearPurchaseError}"/>
                        </Grid> <!--YearPurchaseVehicle-->

                        <BoxView Style="{DynamicResource BoxViewCustom}"/>

                        <VerticalStackLayout Padding="15,10">
                            <Label Text="{Binding MileageText}" Style="{DynamicResource LabelInfoForEntry}" 
                                   FontAttributes="Bold" Margin="0,0,0,5"/>
                            <Entry Text="{Binding Mileage}" Placeholder="0" Keyboard="Numeric" FontSize="16" Style="{DynamicResource LabelCustom}"/>
                            <Label Text="{Binding MileageError}" IsVisible="{Binding IsMileageError}" Style="{DynamicResource LabelError}"/>
                        </VerticalStackLayout> <!--MIleage-->

                        <BoxView Style="{DynamicResource BoxViewCustom}"/>

                        <VerticalStackLayout Padding="15,10">
                            <Label Text="{Binding FuelTankText}" Style="{DynamicResource LabelInfoForEntry}" 
                                   FontAttributes="Bold" Margin="0,0,0,5"/>
                            <Entry Text="{Binding FuelTank}" Placeholder="0" Keyboard="Numeric" FontSize="16" Style="{DynamicResource LabelCustom}"/>
                            <Label Text="{Binding FuelTankError}" IsVisible="{Binding IsFuelTankError}" Style="{DynamicResource LabelError}"/>
                        </VerticalStackLayout>
                        <!--FuelTank-->

                        <BoxView Style="{DynamicResource BoxViewCustom}"/>

                        <VerticalStackLayout Padding="15,10">
                            <Label Style="{DynamicResource LabelInfoForEntry}" Text="Выберите тип вашего ТС"/>
                            <Grid ColumnDefinitions="*,*" RowDefinitions="*,*,auto" RadioButtonGroup.GroupName="VehicleType"
                      RadioButtonGroup.SelectedValue="{Binding SelectedTypeVehicle}">
                                <RadioButton  Grid.Column="0" Grid.Row="0" Content="Автомобиль" Value="Автомобиль" Margin="15,0,0,0"/>

                                <RadioButton Grid.Column="1" Grid.Row="0" Content="Мотоцикл" Value="Мотоцикл" Margin="15,0,0,0" />

                                <RadioButton Grid.Column="0" Grid.Row="1"  Content="Другое" Value="Другое" Margin="15,0,0,0"/>
                            </Grid>
                            <Label  Style="{DynamicResource LabelError}" Text="{Binding TypeVehicleError}"
                                   IsVisible="{Binding IsTypeVehicleError}"/>
                        </VerticalStackLayout> <!--VehicleType-->

                    </VerticalStackLayout>
                    
                </Border> <!--Карточка основной информации-->
                
                <toolkit:Expander Margin="0,10">
                    
                    <toolkit:Expander.Header>
                        <Border Style="{DynamicResource BorderForExpanderAddInfo}">
                            <Grid ColumnDefinitions="*, Auto">

                                <Label Grid.Column="0" Text="Дополнительная информация" Style="{DynamicResource LabelCustom}" FontSize="14"/>

                                <Label Grid.Column="1" Text="▼" Style="{DynamicResource LabelArrowDown}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" 
                                                     Binding="{Binding Source={RelativeSource AncestorType={x:Type toolkit:Expander}}, Path=IsExpanded}" 
                                                     Value="True">
                                            <Setter Property="Rotation" Value="180" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Grid>
                        </Border>
                    </toolkit:Expander.Header> <!--Информации expander-->

                    <toolkit:Expander.Content>
                        <VerticalStackLayout Spacing="15" Padding="5">
                            
                            <Border Style="{DynamicResource BorderForEntryCard}">
                                <VerticalStackLayout Spacing="0">

                                    <Label Text="Данная информация поможет автоматически подстроить типы ремонта для вашего авто"
                                           Style="{DynamicResource LabelSecondaryCustom}" Padding="10"/>

                                    <BoxView HeightRequest="1" Color="{DynamicResource BoxViewColor}" Margin="15,0,0,0"/>

                                    <VerticalStackLayout Padding="15,10">
                                        <Label Text="VIN CODE" Style="{DynamicResource LabelInfoForEntry}"/>
                                        <Entry Text="{Binding VinCode}" Placeholder="vin" Keyboard="Text" 
                                               Style="{DynamicResource EntryImput}"/>
                                    </VerticalStackLayout>
                                    <!--VinCOde-->

                                    <BoxView HeightRequest="1" Color="{DynamicResource BoxViewColor}" Margin="15,0,0,0"/>

                                    <VerticalStackLayout Padding="15,10">
                                        <Label Text="Гос номер вашего авто" Style="{DynamicResource LabelInfoForEntry}"/>
                                        <Entry Style="{DynamicResource EntryImput}" Placeholder="номер" 
                                               Text="{Binding StateNumber}" Keyboard="Text"/>
                                    </VerticalStackLayout> <!--StateNumber-->

                                    <BoxView HeightRequest="1" Color="{DynamicResource BoxViewColor}" Margin="15,0,0,0"/>

                                    <VerticalStackLayout Padding="15,10">
                                        <Label Style="{DynamicResource LabelInfoForEntry}" Text="Выберите тип вашей коробки"/>
                                        <Grid RowDefinitions="auto,auto" HorizontalOptions="Center" RadioButtonGroup.GroupName="Transmission"
                                              RadioButtonGroup.SelectedValue="{Binding TransmissionType, Mode=TwoWay}">
                                            <RadioButton  Grid.Row="0" Content="Механическая (МКПП)" Value="Механическая"/>

                                            <RadioButton Grid.Row="1" Content="Автоматическая(АКПП)" Value="Автоматическая"/>
                                        </Grid>
                                    </VerticalStackLayout>
                                    <!--TransmissionType-->


                                </VerticalStackLayout>
                            </Border>
                            <!--Карточка основной информации-->

                        </VerticalStackLayout>
                    </toolkit:Expander.Content> <!--Контент доп информации-->
                    
                </toolkit:Expander> <!--доп информация-->

                <BoxView Style="{DynamicResource BoxViewCustom}"/>

                <Label Text="Регламент обслуживания" FontAttributes="Bold" FontSize="18"
                       Style="{DynamicResource LabelCustom}" HorizontalOptions="Center"/> <!--Регламент обслуживания текст-->

                <Label Text="Отметьте, что вы уже заменили недавно. Остальное приложение предложит заменить само. Или же можете отметить что авто полностью обслужено. В будущем регламенты ремонта и категории можно будет добавлять свои" 
                       Style="{DynamicResource LabelSecondaryCustom}" FontSize="12" Margin="0,0,0,10" HorizontalOptions="Center"/>

            </VerticalStackLayout> <!--Основная информация и доп авто-->

            <VerticalStackLayout Padding="20,15,20,40">
                <Button Text="{Binding ButtonName}" 
                            Style="{StaticResource ButtonCustomStandartRed}"
                            Command="{Binding ProcessingCommand}"/>
            </VerticalStackLayout> <!--кнопка создания-->

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>