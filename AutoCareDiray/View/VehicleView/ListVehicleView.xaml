<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vmVehicle="clr-namespace:AutoCareDiray.Shared.ViewModels.VehicleViewModel;assembly=AutoCareDiray.Shared" 
             x:Class="AutoCareDiray.View.VehicleView.ListVehicleView"
             Style="{StaticResource CustomPage}">

    <ScrollView HorizontalScrollBarVisibility="Never"
                VerticalScrollBarVisibility="Never">
        <Grid RowDefinitions="*,100">
            <VerticalStackLayout Grid.Row="0">
                <CollectionView ItemsSource="{Binding Vehicles}"
                                SelectedItem="{Binding SelectedVehicle}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command ="{Binding Source={RelativeSource AncestorType= {x:Type vmVehicle:ListVehicleViewModel}},
                                        Path=GoCarCardCommand}"
                                                          CommandParameter="{Binding .}">
                                    </TapGestureRecognizer>
                                </Border.GestureRecognizers>

                                <VerticalStackLayout HeightRequest="80">
                                    <Grid ColumnDefinitions="100,auto,*">
                                        <Image Source="car_icon.png"
                                               HeightRequest="50"
                                               WidthRequest="50"
                                               Margin="0,10,0,0"
                                               VerticalOptions="Center"/>
                                        <Label Text="{Binding NameVehicle}" 
                                                FontSize="20"
                                                Grid.Column="2"
                                                Margin="0,10,0,0"
                                                HorizontalOptions="Start"
                                                VerticalOptions="Center"
                                                TextColor="{DynamicResource TextPrimaryRed}"
                                                FontFamily="{StaticResource RubikRegular}"/>
                                        <ImageButton Source="delete_image.png"
                                                     Grid.Column="2"
                                                     HeightRequest="30"
                                                     WidthRequest="30"
                                                     HorizontalOptions="End"
                                                     Margin="0,10,40,0"
                                                     Style="{StaticResource ImageButtonStandart}"
                                                     Command="{Binding Source={RelativeSource AncestorType={x:Type vmVehicle:ListVehicleViewModel}},Path=DeleteVehicleCommand}"
                                                     CommandParameter="{Binding .}"/>     
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="1">
                <ImageButton HeightRequest="80"
                             WidthRequest="80"
                             Source="plus_icon.png"
                             Command="{Binding GoCreateVehicleCommand}"/>

            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>