<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vmVehicle="clr-namespace:AutoCareDiray.Shared.ViewModels.VehicleViewModel;assembly=AutoCareDiray.Shared" 
             x:Class="AutoCareDiray.View.VehicleView.ListVehicleView"
             xmlns:behaviors="clr-namespace:AutoCareDiray.Controls.Behaviors"
             Style="{StaticResource CustomPage}">

    <Shell.TitleView>
        <HorizontalStackLayout VerticalOptions="Center">
            <Label Text="Список ТС" Style="{DynamicResource LabelCustomPage}" />
        </HorizontalStackLayout>
    </Shell.TitleView>

    <Grid>

        <CollectionView ItemsSource="{Binding Vehicles, Mode=TwoWay}" 
                        SelectedItem="{Binding SelectedVehicle}"
                        SelectionMode="None">

            <CollectionView.EmptyView>
                <Label Text="🤷‍♂️ Кажется тут пусто." Style="{DynamicResource LabelInfo}" FontSize="20"/>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="10,15,10,10">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" CommandParameter="{Binding .}"/>
                        </Grid.GestureRecognizers>

                        <Border Style="{DynamicResource BorderForCollectionView}">
                            <Grid ColumnDefinitions="Auto, *, Auto" Style="{DynamicResource GridForCardList}">
                                <Border Grid.Column="0" Style="{DynamicResource BorderListIndicator}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding NeedsService}" Value="False">
                                            <Setter Property="Stroke" Value="{DynamicResource StatusCompleted}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding NeedsService}" Value="True">
                                            <Setter Property="Stroke" Value="{DynamicResource StatusOverdue}"/>
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Image Source="{Binding PhotoVehicle}" Style="{StaticResource ImageForList}"/>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding NameVehicle}" Style="{DynamicResource LabelCustomMain}"/>
                                    <Label Text="{Binding DisplayMileage}" Style="{DynamicResource LabelSecondaryCustom}"/>
                                    <Label Text="{Binding StateNumber}" Style="{DynamicResource LabelSecondaryCustom}"/>
                                    <Grid Shadow="{StaticResource ShadowRedLightForGrid}" IsVisible="{Binding LabelWarningRepair}">
                                        <Label Text="{Binding WarningRepair}" Style="{StaticResource LabelWarningForCard}" IsVisible="{Binding IsWarningRepair}"/>
                                    </Grid>
                                </VerticalStackLayout>
                                <ImageButton Grid.Column="2" 
                                             Style="{DynamicResource ImageKebab}"
                                             Source="dots_image.png"  
                                             Command="{Binding Source={RelativeSource AncestorType={x:Type vmVehicle:ListVehicleViewModel}}, Path=ShowVehicleOptionsCommand}"
                                             CommandParameter="{Binding .}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <BoxView HeightRequest="100" Color="{DynamicResource PrimaryWhite}" />
            </CollectionView.Footer>

        </CollectionView>

        <Grid Style="{StaticResource GridForButtonCreate}"
              VerticalOptions="End" 
              HorizontalOptions="End" 
              Margin="0, 0, 20, 30">
            <Button Command="{Binding GoCreateVehicleCommand}" Style="{DynamicResource ButtonCreate}"/>
        </Grid>

    </Grid>
</ContentPage>