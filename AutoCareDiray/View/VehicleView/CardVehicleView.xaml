<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vmVehicle="clr-namespace:AutoCareDiray.Shared.ViewModels.VehicleViewModel;assembly=AutoCareDiray.Shared"
             x:Class="AutoCareDiray.View.VehicleView.CardVehicleView"
             Style="{DynamicResource CustomPage}">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="10">


            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Grid.Column="1">
                <Border Style="{DynamicResource BorderPhoto}" WidthRequest="150" HeightRequest="150" Margin="0,0,0,10" >
                    <Image Source="{Binding VehicleCard.PhotoVehicle}" Aspect="AspectFill"/>
                </Border>
                <Label Text="{Binding  VehicleCard.NameVehicle}" FontSize="18" Style="{DynamicResource LabelCustom}" HorizontalOptions="Center"/>
            </VerticalStackLayout> <!--фото и название авто-->

            <Border Style="{DynamicResource BorderForCardInfo}">
                <Grid ColumnDefinitions="auto,auto" RowDefinitions="auto,auto,auto,auto" ColumnSpacing="10" RowSpacing="15" Padding="5">

                    <HorizontalStackLayout Grid.Column="0" Grid.Row="0">
                        <VerticalStackLayout>
                            <Label Text="Пробег авто" Style="{DynamicResource LabelForCardInfoCategory}"/>
                            <Label Grid.Column="1" Text="{Binding VehicleCard.Mileage,StringFormat='{0:N0} км'}" 
                                   Style="{DynamicResource LabelForCardInfoData}"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout> <!--Mileage-->

                    <HorizontalStackLayout Grid.Column="0" Grid.Row="1">
                        <!--<Image Source="date_icon.png" Style="{StaticResource ImageForCardInfo}"/>-->
                        <VerticalStackLayout>
                            <Label Text="Дата производства " Style="{DynamicResource LabelForCardInfoCategory}"/>
                            <Label Grid.Column="1" Text="{Binding VehicleCard.YearCreate, StringFormat='{0:d}'}"  Style="{DynamicResource LabelForCardInfoData}"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout> <!--CreateVehicle-->

                    <HorizontalStackLayout Grid.Column="1" Grid.Row="1">
                        <!--<Image Source="date_icon.png" Style="{StaticResource ImageForCardInfo}"/>-->
                        <VerticalStackLayout>
                            <Label Text="Дата покупки" Style="{DynamicResource LabelForCardInfoCategory}"/>
                            <Label Grid.Column="1" Text="{Binding VehicleCard.YearPurchase, StringFormat='{0:d}'}" Style="{DynamicResource LabelForCardInfoData}"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout> <!--PurchaseVehicle-->

                    <HorizontalStackLayout Grid.Column="0" Grid.Row="2">
                        <!--<Image Source="vincode_icon.png" Style="{StaticResource ImageForCardInfo}"/>-->
                        <VerticalStackLayout>
                            <Label Text="VinCode" Style="{DynamicResource LabelForCardInfoCategory}"/>
                            <Label Grid.Column="1" Text="{Binding VehicleCard.VinCode}" Style="{DynamicResource LabelForCardInfoData}"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout> <!--VinCode-->

                    <HorizontalStackLayout Grid.Column="1" Grid.Row="2">
                        <!--<Image Source="flag_icon.png" Style="{StaticResource ImageForCardInfo}"/>-->
                        <VerticalStackLayout>
                            <Label Text="Гос номер" Style="{DynamicResource LabelForCardInfoCategory}"/>
                            <Label Grid.Column="1" Text="{Binding VehicleCard.StateNumber}" Style="{DynamicResource LabelForCardInfoData}"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout> <!--StateNumber-->

                    <HorizontalStackLayout Grid.Column="0" Grid.Row="3">
                        <!--<Image Source="transmission_icon.png" Style="{StaticResource ImageForCardInfo}"/>-->
                        <VerticalStackLayout>
                            <Label Text="Коробка" Style="{DynamicResource LabelForCardInfoCategory}"/>
                            <Label Grid.Column="1" Text="{Binding VehicleCard.TransmissionType}" Style="{DynamicResource LabelForCardInfoData}"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout> <!--TransmissionType-->

                    <HorizontalStackLayout Grid.Column="1" Grid.Row="3">
                        <!--<Image Source="carcard_icon.png" Style="{StaticResource ImageForCardInfo}"/>-->
                        <VerticalStackLayout>
                            <Label Text="Тип авто" Style="{DynamicResource LabelForCardInfoCategory}"/>
                            <Label Grid.Column="1" Text="{Binding VehicleCard.VehicleType}" Style="{DynamicResource LabelForCardInfoData}"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout> <!--TypeVehicle-->

                </Grid>
            </Border> <!--шапка данных авто-->

            <Border Style="{DynamicResource BorderForCardInfo}">
                <VerticalStackLayout RadioButtonGroup.GroupName="Mode" RadioButtonGroup.SelectedValue="{Binding SelectedMode}">
                    <RadioButton Content="Информация по диагностике" x:Name="DiagnosticsButton" Value="Diagnostics" />
                    <RadioButton Content="Заметки моего авто" x:Name="NotesButton" Value="Notes"/>
                    <RadioButton Content="Отчет авто" x:Name="ReportVehicle" Value="Report"/>
                </VerticalStackLayout>
            </Border> <!--кнопки режимов-->

            <BoxView HeightRequest="1" Color="#E0E0E0" Margin="0,10"/>

            <CollectionView ItemsSource="{Binding WarningRepairType, Mode=TwoWay}" SelectionMode="None" 
                            IsVisible="{Binding Source={x:Reference DiagnosticsButton},Path=IsChecked}">

                <CollectionView.Header>
                    <Label Text="Информация по диагностики" Style="{DynamicResource LabelCustom}"
                           HorizontalOptions="Center" Margin="0,5,0,30"/>
                    <!--информация о переходе на предупреждения-->
                </CollectionView.Header>
                <CollectionView.EmptyView>
                    <Label Text="По моим подсчетам авто исправно"
                Style="{DynamicResource LabelInfo}"
                FontSize="20"/>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="10,5,10,10">
                            <!--Выдвижение карточки для анимации-->

                            <Border Style="{DynamicResource BorderForCollectionView}">
                                <Grid ColumnDefinitions="Auto, *" Style="{DynamicResource GridForCardList}">

                                    <Image Source="repair_image.png" Style="{StaticResource ImageForList}"/>

                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                            
                                        <Label Text="{Binding TitleRepair}" Style="{DynamicResource LabelCustom}"/>

                                        <!--<Label Text="{Binding Mileage, StringFormat='{0:N0} км'}" 
                                               Style="{DynamicResource LabelSecondaryCustom}"/>-->

                                    </VerticalStackLayout>
                                    <!--Данные авто-->
                                </Grid>
                            </Border>
                            <!--Обертка карточки-->
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView> <!--карточки информации о проведении диагностики-->

            <VerticalStackLayout IsVisible="{Binding Source={x:Reference NotesButton},Path=IsChecked}" Padding="5">
                
                <Border Style="{DynamicResource BorderForCardInfo}" Padding="5" Margin="0,0,0,20">
                    <VerticalStackLayout>
                        <Entry Text="{Binding NewTitleNote}" Style="{DynamicResource EntryImput}" FontSize="18" Placeholder="Заголовок"/>
                        <BoxView Style="{DynamicResource BoxViewCustom}" WidthRequest="600"/>
                        <Editor Text="{Binding NewContentNote}" Style="{DynamicResource EditorStandart}" Placeholder="текст заметки"/>
                        <Button Style="{DynamicResource ButtonCustomStandartRed}" Text="{Binding ButtonName}" Margin="0,20,0,20"
                                HeightRequest="40" WidthRequest="150" Command="{Binding interactionNoteCommand}"/>
                    </VerticalStackLayout>
                </Border> <!--создание заметки-->

                <CollectionView ItemsSource="{Binding VehicleNotes}">

                    <CollectionView.Header>
                        <Label Text="Ваши заметки" Style="{DynamicResource LabelCustom}"/>
                    </CollectionView.Header>

                    <CollectionView.EmptyView>
                        <Label Text="У вас пока нету заметок. Можете попробовоть создать их" Style="{DynamicResource LabelSecondaryCustom}"/>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <VerticalStackLayout Margin="0,0,0,20" Padding="5">
                                <Border Style="{DynamicResource BorderForCollectionView}" Padding="5">
                                    <VerticalStackLayout>
                                        <ImageButton Grid.Column="2" Style="{DynamicResource ImageKebab}" Source="dots_image.png"  
                                                     Command="{Binding Source={RelativeSource AncestorType={x:Type vmVehicle:CardVehicleViewModel}}, Path=ShowNotesOptionsCommand}"
                                                     CommandParameter="{Binding .}" HorizontalOptions="End"/>
                                        <!--Кебаб меню для карточки авто-->
                                        <Label Text="{Binding Title}" Style="{DynamicResource LabelCustom}" FontSize="16" Grid.Column="0"/>
                                        <BoxView HeightRequest="1" Color="#E0E0E0" Margin="0,10"/>
                                        <Label Text="{Binding Content}" Style="{DynamicResource LabelCustom}" FontSize="14"/>
                                        <Label Text="{Binding DateCreated,StringFormat= ' Редактированно {0:dd/MM/yy HH:mm}'}" Style="{DynamicResource LabelInfoForEntry}"
                                               FontSize="10"/>
                                    </VerticalStackLayout>
                                </Border>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView> <!--заметки-->

            </VerticalStackLayout> <!--заметки-->

            <VerticalStackLayout IsVisible="{Binding Source={x:Reference ReportVehicle},Path=IsChecked}" Padding="5">
                
                <Border Style="{DynamicResource BorderForCardInfo}">
                    <VerticalStackLayout RadioButtonGroup.GroupName="YearRepair" RadioButtonGroup.SelectedValue="{Binding SelectedYearReport}"
                                         Padding="0" Spacing="10">
                        <Label Text="{Binding VehicleCard.PdfFile}"/>
                        <Button Text="Открыть отчет" Command="{Binding OpenPdfFileCommand}" Style="{DynamicResource ButtonCustomStandartRed}"
         HeightRequest="20" WidthRequest="150" Margin="0,0,10,20"/>
                        
                        <Label Text="Выберите данные формирования отчета" Padding="5"/>
                        <RadioButton Content="Отчет за этот год" Value="NowYear" />
                        <RadioButton Content="Отчет за прошлый год" Value="PastYear" />
                        <RadioButton Content="Отчет c момента покупки авто" Value="Full"/>
                        <Button Text="Сформировать отчет" Command="{Binding CreatePdfStatVehicleCommand}" Style="{DynamicResource ButtonCustomStandartRed}"
                                HeightRequest="40" WidthRequest="200" Margin="0,10,0,30"/>
                    </VerticalStackLayout>
                </Border>
                
            </VerticalStackLayout>
            
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>