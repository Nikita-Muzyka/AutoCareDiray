<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AutoCareDiray.View.MainPage"
             Title="MainPage">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--Profil-->
        <StackLayout>
            <Button HeightRequest="10"
                 WidthRequest="100"
                 HorizontalOptions="End"
                 Text="Profil"
                 Command="{Binding UserSettingsGoCommand}">
            </Button>
        </StackLayout>
        <!--Create Car-->
        <StackLayout Grid.Row="1"
                  HorizontalOptions="Start">
            <ListView>

            </ListView>
            <Button Text="Создать Авто"
                 Command="{Binding CreateCarCommand}"/>
        </StackLayout>
    </Grid>
</ContentPage>