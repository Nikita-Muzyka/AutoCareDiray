<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AutoCareDiray.View.RepairView.CreateRepairView"
             xmlns:vm="clr-namespace:AutoCareDiray.Shared.ViewModels.RepairViewModel;assembly=AutoCareDiray.Shared"
             Style="{StaticResource CustomPage}">

    <Shell.TitleView>
        <HorizontalStackLayout VerticalOptions="Center">
            <Label Text="Журнал событий ТС" Style="{DynamicResource LabelCustomPage}" />
        </HorizontalStackLayout>
    </Shell.TitleView>

    <ScrollView>
        <VerticalStackLayout Spacing="15" Padding="15,20,15,40">

            <Label Text="Добавление ремонта" FontSize="22" Margin="0,0,0,5" Style="{DynamicResource LabelCustomMain}" HorizontalOptions="Center"/>

            <!-- ==================================================== -->
            <!-- КАРТОЧКА 1: ВЫБОР ИЛИ СОЗДАНИЕ ТИПА РЕМОНТА          -->
            <!-- ==================================================== -->
            <Border Style="{DynamicResource BorderForEntryCard}" Padding="15">
                <VerticalStackLayout Spacing="10">

                    <!-- Выбор существующего типа -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Тип обслуживания" Style="{DynamicResource LabelInfoForEntry}"/>
                        <Grid ColumnDefinitions="*, Auto">
                            <Picker Grid.Column="0" Title="Выберите тип..." ItemsSource="{Binding RepairTypes}" ItemDisplayBinding="{Binding TitleRepair}" 
                                    SelectedItem="{Binding SelectedRepairType}" Style="{DynamicResource PickerStandart}"/>
                            <Label Grid.Column="1" Text="▼" Style="{DynamicResource LabelArrowDown}"/>
                        </Grid>
                        <Label Text="{Binding SelectedRepairTypeError}" Style="{DynamicResource LabelError}" IsVisible="{Binding IsSelectedRepairTypeError}"/>
                    </VerticalStackLayout>

                    <!-- Кнопки переключения режимов -->
                    <Button Text="+ Создать новый тип" Style="{StaticResource ButtonCustomStandartMini}" 
                            Command="{Binding ShowMenuCreateNewRepairTypeCommand}"
                            IsVisible="{Binding IsButtonCreateRepairType}" Margin="0,5,0,0"/>

                    <Button Text="Отменить создание" Style="{StaticResource ButtonCustomStandartMini}" BackgroundColor="{DynamicResource PrimarySecondary}"
                            Command="{Binding CancelCreateNewTypeRepairCommand}"
                            IsVisible="{Binding IsCancelCreateRepairType}" Margin="0,5,0,0"/>

                    <!-- БЛОК СОЗДАНИЯ НОВОГО ТИПА (Скрыт по умолчанию) -->
                    <VerticalStackLayout Spacing="15" IsVisible="{Binding IsCreateNewType}" Margin="0,15,0,0">
                        <BoxView HeightRequest="1" Color="{DynamicResource BoxViewColor}" Margin="-15,0,-15,10"/>
                        <Label Text="Создание нового типа" Style="{DynamicResource LabelCustomMain}"/>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Категория" Style="{DynamicResource LabelInfoForEntry}"/>
                            <Grid ColumnDefinitions="*,auto">
                                <Picker Grid.Column="0" Title="Выберите..." ItemsSource="{Binding Categories}" 
                                        SelectedItem="{Binding SelectedCategory}" Style="{DynamicResource PickerStandart}"/>
                                <Label Grid.Column="1" Text="▼" Style="{DynamicResource LabelArrowDown}"/>
                            </Grid>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Название ремонта" Style="{DynamicResource LabelInfoForEntry}"/>
                            <Entry Text="{Binding TitleNewRepairType}" Placeholder="Замена колодок" Style="{DynamicResource EntryImput}"/>
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                            <VerticalStackLayout Grid.Column="0" Spacing="5">
                                <!-- ИСПРАВЛЕНО: Используем StringFormat для вставки км/миль в скобки -->
                                <Label Text="{Binding MileageUnit, StringFormat='Интервал ({0})'}" Style="{DynamicResource LabelInfoForEntry}"/>
                                <Entry Text="{Binding IntervalMileageNewType}" Placeholder="15000" Keyboard="Numeric" Style="{DynamicResource EntryImput}"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="5">
                                <Label Text="Интервал (мес)" Style="{DynamicResource LabelInfoForEntry}"/>
                                <Entry Text="{Binding IntervalMonthNewType}" Placeholder="12" Keyboard="Numeric" Style="{DynamicResource EntryImput}"/>
                            </VerticalStackLayout>
                        </Grid>

                        <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" 
        Text="+ Сохранить тип" 
        Style="{DynamicResource ButtonCustomStandart}" 
        Command="{Binding CreateSparePartCommand}" 
        Margin="0,10,0,0"/>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- ==================================================== -->
            <!-- ОСТАЛЬНАЯ ФОРМА (ПОКАЗЫВАЕТСЯ ТОЛЬКО ПОСЛЕ ВЫБОРА)   -->
            <!-- ==================================================== -->
            <VerticalStackLayout IsVisible="{Binding IsCurrentRepairType}" Spacing="15">

                <!-- КАРТОЧКА 2: ОСНОВНЫЕ ДАННЫЕ (Дата, Пробег, Интервалы) -->
                <Border Style="{DynamicResource BorderForEntryCard}" Padding="15,5">
                    <VerticalStackLayout Spacing="0">

                        <!-- Дата ремонта -->
                        <Grid ColumnDefinitions="30, *, Auto" Padding="0,12">
                            <Label Grid.Column="0" Text="📅" FontSize="18" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="Дата ремонта" Style="{DynamicResource LabelInfoForEntry}" VerticalOptions="Center"/>
                            <DatePicker Grid.Column="2" Format="d" Date="{Binding DateRepairSelected}" MaximumDate="{Binding DateNow}" VerticalOptions="Center" />
                        </Grid>
                        <BoxView Style="{DynamicResource BoxViewCustom}" Margin="35,0,0,0"/>

                        <!-- Текущий пробег авто -->
                        <Grid ColumnDefinitions="30, *, Auto" RowDefinitions="Auto, Auto" Padding="0,12">
                            <Label Grid.Row="0" Grid.Column="0" Text="🚗" FontSize="18" VerticalOptions="Center"/>
                            <Label Grid.Row="0" Grid.Column="1" Text="Пробег при замене" Style="{DynamicResource LabelInfoForEntry}" VerticalOptions="Center"/>
                            <Entry Grid.Row="0" Grid.Column="2" Text="{Binding MileageFilled}" Placeholder="155000" Keyboard="Numeric" 
                                   Style="{DynamicResource EntryImput}" WidthRequest="100" HorizontalTextAlignment="End"/>

                            <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding MileageError}" 
                                   Style="{DynamicResource LabelError}" IsVisible="{Binding IsMileageError}" HorizontalOptions="End"/>
                        </Grid>
                        <BoxView Style="{DynamicResource BoxViewCustom}" Margin="35,0,0,0"/>

                        <!-- Интервалы обслуживания -->
                        <VerticalStackLayout Padding="0,12" Spacing="8">

                            <!-- Заголовок блока -->
                            <Grid ColumnDefinitions="30, *">
                                <Label Grid.Column="0" Text="⏳" FontSize="18" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="Следующее обслуживание через:" Style="{DynamicResource LabelInfoForEntry}" VerticalOptions="Center"/>
                            </Grid>

                            <!-- Поля ввода с подписями -->
                            <Grid ColumnDefinitions="*, *" ColumnSpacing="15" Margin="30,0,0,0">

                                <!-- Колонка 1: Пробег -->
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="Пробег" Style="{DynamicResource LabelSecondaryCustom}" FontSize="12"/>
                                    <HorizontalStackLayout Spacing="5">
                                        <Entry Text="{Binding IntervalMileageFilled}" Placeholder="10000" Keyboard="Numeric" 
               Style="{DynamicResource EntryImput}" WidthRequest="80" HorizontalTextAlignment="Center"/>

                                        <!-- ИСПРАВЛЕНО: Теперь берет единицу измерения из ViewModel -->
                                        <Label Text="{Binding MileageUnit}" Style="{DynamicResource LabelCustomMain}" VerticalOptions="Center" FontSize="15"/>

                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <!-- Колонка 2: Месяцы -->
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="Время" Style="{DynamicResource LabelSecondaryCustom}" FontSize="12"/>
                                    <HorizontalStackLayout Spacing="5">
                                        <Entry Text="{Binding IntervalMonthsFilled}" Placeholder="12" Keyboard="Numeric" 
                       Style="{DynamicResource EntryImput}" WidthRequest="60" HorizontalTextAlignment="Center"/>
                                        <Label Text="мес" Style="{DynamicResource LabelCustomMain}" VerticalOptions="Center" FontSize="15"/>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                            </Grid>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- КАРТОЧКА 3: ЗАПЧАСТИ -->
                <Border Style="{DynamicResource BorderForEntryCard}" Padding="15">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="⚙️ Добавление запчастей" Style="{DynamicResource LabelCustomMain}" FontSize="16"/>

                        <!-- Форма добавления -->
                        <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto, Auto" RowSpacing="10" ColumnSpacing="10">
                            <!-- Название -->
                            <VerticalStackLayout Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Spacing="5">
                                <Label Text="Название детали" Style="{DynamicResource LabelInfoForEntry}"/>
                                <Entry Text="{Binding CreateNamePart}" Placeholder="Стойка стабилизатора" Style="{DynamicResource EntryImput}"/>
                            </VerticalStackLayout>

                            <!-- Артикул -->
                            <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="5">
                                <Label Text="Артикул" Style="{DynamicResource LabelInfoForEntry}"/>
                                <Entry Text="{Binding CreateArticleNumberPart}" Placeholder="51320" Style="{DynamicResource EntryImput}"/>
                            </VerticalStackLayout>

                            <!-- Стоимость + Валюта -->
                            <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="5">
                                <Label Text="Стоимость" Style="{DynamicResource LabelInfoForEntry}"/>
                                <HorizontalStackLayout Spacing="5">
                                    <Entry Text="{Binding CreateCostPart}" Keyboard="Numeric" Placeholder="2040" Style="{DynamicResource EntryImput}" HorizontalOptions="FillAndExpand"/>
                                    <Picker ItemsSource="{Binding CurrencyPicker}" SelectedItem="{Binding SelectedCurrencySignPart}" 
                                            Style="{DynamicResource PickerStandart}" WidthRequest="50" HorizontalTextAlignment="Center"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="+ Добавить в список" 
        Style="{DynamicResource ButtonCustomStandartMiniGold}" 
        Command="{Binding CreateSparePartCommand}" 
        Margin="0,10,0,0"/>
                        </Grid>

                        <!-- Список добавленных запчастей -->
                        <CollectionView ItemsSource="{Binding ListSpareParts, Mode=TwoWay}" SelectedItem="{Binding SelectedSparePart}" SelectionMode="None" Margin="0,10">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="10,5">
                                        <Border Style="{DynamicResource BorderForCollectionView}">
                                            <Grid ColumnDefinitions="*, Auto, Auto" Style="{DynamicResource GridForCardList}" Padding="15,10">
                                                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                                                    <Label Text="{Binding NamePart}" Style="{DynamicResource LabelCustomMain}" FontSize="14"/>
                                                    <Label Text="{Binding ArticleNumberPart}" Style="{DynamicResource LabelSecondaryCustom}" FontSize="12"/>
                                                </VerticalStackLayout>

                                                <Label Grid.Column="1" Text="{Binding DisplayCist}" VerticalOptions="Center" Style="{DynamicResource LabelCustomMain}" FontSize="14" Margin="0,0,10,0"/>

                                                <ImageButton Grid.Column="2" Style="{DynamicResource ImageKebab}" Source="dots_image.png"  
                                                             Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CreateRepairViewModel}}, Path=ShowOptionsCommand}"
                                                             CommandParameter="{Binding .}"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- КАРТОЧКА 4: РАБОТЫ И СТОИМОСТЬ -->
                <Border Style="{DynamicResource BorderForEntryCard}" Padding="15">
                    <VerticalStackLayout Spacing="15">

                        <!-- Где выполнялись работы -->
                        <VerticalStackLayout Spacing="5">
                            <Label Style="{DynamicResource LabelInfoForEntry}" Text="Кто выполнял работы?"/>
                            <VerticalStackLayout RadioButtonGroup.GroupName="Job" RadioButtonGroup.SelectedValue="{Binding SelectedJob, Mode=TwoWay}" Spacing="5">
                                <RadioButton x:Name="ServiceButton" Content="В сервисе" Value="Сервис" />
                                <RadioButton Content="Самостоятельно" Value="Самостоятельно"/>
                                <Label Text="{Binding JobError}" Style="{DynamicResource LabelError}" IsVisible="{Binding IsJobError}"/>
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <!-- Название сервиса -->
                        <VerticalStackLayout Spacing="5" IsVisible="{Binding Source={x:Reference ServiceButton},Path=IsChecked}">
                            <Label Text="Название сервиса" Style="{DynamicResource LabelInfoForEntry}"/>
                            <Entry Text="{Binding ServiceName}" Placeholder="Автосервис Игорек" Style="{DynamicResource EntryImput}"/>
                        </VerticalStackLayout>

                        <BoxView Style="{DynamicResource BoxViewCustom}" Margin="0"/>

                        <!-- Итоговая стоимость работ -->
                        <Grid ColumnDefinitions="30, *, Auto" RowDefinitions="Auto, Auto" Padding="0,5">
                            <Label Grid.Row="0" Grid.Column="0" Text="💰" FontSize="18" VerticalOptions="Center"/>
                            <Label Grid.Row="0" Grid.Column="1" Text="Стоимость работ" Style="{DynamicResource LabelInfoForEntry}" VerticalOptions="Center"/>

                            <HorizontalStackLayout Grid.Row="0" Grid.Column="2" Spacing="5" HorizontalOptions="End" VerticalOptions="Center">
                                <Entry Text="{Binding CostFilled}" Placeholder="3500" Keyboard="Numeric" 
                                       Style="{DynamicResource EntryImput}" WidthRequest="100" HorizontalTextAlignment="End"/>
                                <Picker ItemsSource="{Binding CurrencyPicker}" SelectedItem="{Binding SelectedCurrencySignAllCost}" 
                                        Style="{DynamicResource PickerStandart}" WidthRequest="50" HorizontalTextAlignment="Center"/>
                            </HorizontalStackLayout>

                            <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding CostError}" 
                                   Style="{DynamicResource LabelError}" IsVisible="{Binding IsCostError}" HorizontalOptions="End" Margin="0,5,0,0"/>
                        </Grid>

                        <BoxView Style="{DynamicResource BoxViewCustom}" Margin="0"/>

                        <!-- Описание работ -->
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Описание выполненных работ" Style="{DynamicResource LabelInfoForEntry}"/>
                            <Editor Text="{Binding DescriptionFilled}" Placeholder="Что именно сделали..." HeightRequest="80" Style="{DynamicResource EditorStandart}"/>
                        </VerticalStackLayout>

                        <!-- Комментарий мастера -->
                        <VerticalStackLayout Spacing="5" IsVisible="{Binding Source={x:Reference ServiceButton},Path=IsChecked}">
                            <Label Text="Комментарий мастера" Style="{DynamicResource LabelInfoForEntry}"/>
                            <Editor Text="{Binding CommentMechanic}" Placeholder="Рекомендации..." HeightRequest="60" Style="{DynamicResource EditorStandart}"/>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <!-- КАРТОЧКА 5: ФОТОГРАФИИ ЧЕКОВ -->
                <Border Style="{DynamicResource BorderForEntryCard}" Padding="15">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="📸 Фото чеков/заказ-нарядов" Style="{DynamicResource LabelCustomMain}" FontSize="15" VerticalOptions="Center"/>
                            <Button Grid.Column="1" Text="Прикрепить" Style="{DynamicResource ButtonCustomStandartMiniGold}" Command="{Binding AttachPhotoCommand}"/>
                        </Grid>

                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,5,0,0" HeightRequest="110">
                            <HorizontalStackLayout BindableLayout.ItemsSource="{Binding AttachedPhotos}" Spacing="10">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border WidthRequest="100" HeightRequest="100" Padding="0" Style="{DynamicResource BorderForCardImage}">
                                            <Grid>
                                                <Image Source="{Binding .}" Aspect="AspectFill" />
                                                <Button Text="✕" TextColor="White" BackgroundColor="#80000000" 
                                                        WidthRequest="30" HeightRequest="30" Padding="0"
                                                        CornerRadius="15" HorizontalOptions="End" VerticalOptions="Start" Margin="5"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CreateRepairViewModel}}, Path=DeleteAttachPhotoCommand}"
                                                        CommandParameter="{Binding .}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </ScrollView>
                    </VerticalStackLayout>
                </Border>

                <!-- Ошибки и Сохранение -->
                <Label Text="{Binding StatusMessage}" Style="{DynamicResource LabelError}" HorizontalOptions="Center"/>

                <VerticalStackLayout Padding="0,10,0,20">
                    <Button Text="{Binding ButtonName}" Style="{StaticResource ButtonCustomStandart}" Command="{Binding ProcessingRepairCommand}"/>
                </VerticalStackLayout>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>