<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AutoCareDiray.View.RepairView.CreateRepairView"
             xmlns:vm="clr-namespace:AutoCareDiray.Shared.ViewModels.RepairViewModel;assembly=AutoCareDiray.Shared"
             Style="{StaticResource CustomPage}">

    <ScrollView>
        <VerticalStackLayout Spacing="15" Padding="15">

            <Label Text="Информация о ремонте" FontSize="18" Margin="0,10,0,0" Style="{DynamicResource LabelCustom}" HorizontalOptions="Center"/>

            <Border Style="{DynamicResource BorderForEntryCard}">
                <VerticalStackLayout Spacing="0">

                    <VerticalStackLayout>
                        <RadioButton Content="Create" CheckedChanged="CreateNewRepairType"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Padding="15,10">

                        <Label Text="Тип обслуживания" Style="{DynamicResource LabelInfoForEntry}"/>

                        <Grid ColumnDefinitions="*,auto">

                            <Picker Grid.Column="0" Title="Выберите тип..." ItemsSource="{Binding RepairTypes}" ItemDisplayBinding="{Binding TitleRepair}" 
                                    SelectedItem="{Binding SelectedRepairType}" Style="{DynamicResource PickerStandart}"/>
                            <Label Grid.Column="1" Text="▼" Style="{DynamicResource LabelArrowDown}"/>

                        </Grid>

                        <Label Text="{Binding SelectedRepairTypeError}" Style="{DynamicResource LabelError}" IsVisible="{Binding IsSelectedRepairTypeError}"/>

                    </VerticalStackLayout>
                    <!--Picker выбора категории-->

                    <BoxView Style="{DynamicResource BoxViewCustom}"/>

                    <VerticalStackLayout Padding="15,10">

                        <Label Text="создать свой тип ремонта" Style="{DynamicResource LabelInfoForEntry}"/>

                        <Grid RowDefinitions="auto,auto,auto,auto,auto">

                            <VerticalStackLayout Grid.Row="0">
                                <Label Text="Выбор категории" Style="{DynamicResource LabelInfoForEntry}"/>
                                <Grid ColumnDefinitions="*,auto">
                                    <Picker Grid.Column="0" Title="Выберите тип..." ItemsSource="{Binding Categories}" 
                                            SelectedItem="{Binding SelectedCategory}" Style="{DynamicResource PickerStandart}"/>
                                    <Label Grid.Column="1" Text="▼" Style="{DynamicResource LabelArrowDown}"/>
                                </Grid>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="1">
                                <Label Text="Название ремонта" Style="{DynamicResource LabelInfoForEntry}"/>
                                <Entry Text="{Binding TitleNewRepairType}" Placeholder="Например заменил колодки" 
                                       Style="{DynamicResource EntryImput}"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="2">
                                <Label Text="{Binding InvervalMileageNewText}" Style="{DynamicResource LabelInfoForEntry}"/>
                                <Entry Text="{Binding IntervalMileageNewType}" Placeholder="Например 2323223" 
                                       Keyboard="Numeric" Style="{DynamicResource EntryImput}"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout  Grid.Row="3">

                                <Label Text="интервал в месяцах если нужно или оставте 0" Style="{DynamicResource LabelInfoForEntry}"/>
                                <Entry Text="{Binding IntervalMonthNewType}" Keyboard="Numeric" Placeholder="Например 2040" Style="{DynamicResource EntryImput}"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout  Grid.Row="4">
                                <Button Text="+"  Style="{DynamicResource ButtonCreate}" Command="{Binding CreateNewRepairTypeCommand}"/>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                    <!--Picker Создание новой категории-->

                    <BoxView Style="{DynamicResource BoxViewCustom}"/>

                    <Grid ColumnDefinitions="*, Auto" Padding="15,10">
                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                            <Label Text="Дата ремонта" Style="{DynamicResource LabelInfoForEntry}"/>
                        </VerticalStackLayout>
                        <DatePicker Grid.Column="1" Format="d" Date="{Binding DateRepairSelected}" 
                                    MaximumDate="{Binding DateNow}" VerticalOptions="Center" />
                    </Grid>
                    <!--Дата ремонта-->

                    <BoxView Style="{DynamicResource BoxViewCustom}"/>

                    <VerticalStackLayout Padding="15,10">
                        <Label Text="{Binding IntervalMileageText}" Style="{DynamicResource LabelInfoForEntry}"/>
                        <Label Text="Для повторного обслуживания" Style="{DynamicResource LabelSecondaryCustom}" FontSize="11" Margin="0,0,0,5"/>
                        <Entry Text="{Binding IntervalMileageFilled}" Placeholder="Например: 10000" 
                               Keyboard="Numeric" Style="{DynamicResource EntryImput}"/>
                    </VerticalStackLayout>
                    <!--интервал замены пробега-->

                    <BoxView Style="{DynamicResource BoxViewCustom}"/>

                    <VerticalStackLayout Padding="15,10">
                        <Label Text="Интервал замены (мес)" Style="{DynamicResource LabelInfoForEntry}"/>
                        <Label Text="Для повторного обслуживания" Style="{DynamicResource LabelSecondaryCustom}" FontSize="11" Margin="0,0,0,5"/>
                        <Entry Text="{Binding IntervalMonthsFilled}" Placeholder="Например: 24" 
                               Keyboard="Numeric" Style="{DynamicResource EntryImput}"/>
                    </VerticalStackLayout>
                    <!--интервал замены по месяцам-->

                    <BoxView Style="{DynamicResource BoxViewCustom}"/>

                    <VerticalStackLayout Padding="15,10">
                        <Label Text="{Binding MileageText}" Style="{DynamicResource LabelInfoForEntry}"/>
                        <Label Text="Нужен для отчета" Style="{DynamicResource LabelSecondaryCustom}" FontSize="11" Margin="0,0,0,5"/>
                        <Entry Text="{Binding MileageFilled}" Placeholder="Например: 155000" 
                               Keyboard="Numeric" Style="{DynamicResource EntryImput}"/>
                        <Label Text="{Binding MileageError}" Style="{DynamicResource LabelError}" IsVisible="{Binding IsMileageError}"/>
                    </VerticalStackLayout>
                    <!--текущий пробег авто-->

                    <BoxView Style="{DynamicResource BoxViewCustom}"/>

                    <VerticalStackLayout Padding="15,10">

                        <Grid RowDefinitions="auto,auto,auto,auto">
                            <VerticalStackLayout Grid.Row="0">
                                <Label Text="Название детали" Style="{DynamicResource LabelInfoForEntry}"/>
                                <Entry Text="{Binding CreateNamePart}" Placeholder="Стойка стабилизатора" Style="{DynamicResource EntryImput}"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="1">
                                <Label Text="Артикул детали" Style="{DynamicResource LabelInfoForEntry}"/>
                                <Entry Text="{Binding CreateArticleNumberPart}" Placeholder="Например 2323223" Style="{DynamicResource EntryImput}"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout  Grid.Row="2">
                                <Label Text="{Binding CostPartText}" Style="{DynamicResource LabelInfoForEntry}"/>
                                <Entry Text="{Binding CreateCostPart}" Keyboard="Numeric" Placeholder="Например 2040" Style="{DynamicResource EntryImput}"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout  Grid.Row="4">
                                <Button Text="+"  Style="{DynamicResource ButtonCreate}" Command="{Binding CreateSparePartCommand}"/>
                            </VerticalStackLayout>
                        </Grid>


                        <CollectionView ItemsSource="{Binding ListSpareParts, Mode=TwoWay}" SelectedItem="{Binding SelectedSparePart}"
                                        SelectionMode="None">

                            <CollectionView.EmptyView>
                                <Label Text="🤷‍♂️ Кажется тут пусто." Style="{DynamicResource LabelInfo}" FontSize="20"/>
                            </CollectionView.EmptyView>

                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="10,15,10,10">

                                        <Border Style="{DynamicResource BorderForCollectionView}">

                                            <Grid ColumnDefinitions="Auto, *, Auto" Style="{DynamicResource GridForCardList}">

                                                <Border Grid.Column="0" Style="{DynamicResource BorderListIndicator}">

                                                    <Border.Triggers>
                                                        <DataTrigger TargetType="Border" Binding="{Binding NeedsService}" Value="False">
                                                            <Setter Property="Stroke" Value="{DynamicResource StatusCompleted}" />
                                                        </DataTrigger>

                                                        <DataTrigger TargetType="Border" Binding="{Binding NeedsService}" Value="True">
                                                            <Setter Property="Stroke" Value="{DynamicResource StatusOverdue}"/>
                                                        </DataTrigger>
                                                    </Border.Triggers>

                                                    <Image Source="car_icon.png"
                                   Style="{StaticResource ImageForList}"/>
                                                </Border>
                                                <!--Border индикатор круг для авто-->

                                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">

                                                    <Label Text="{Binding NamePart}" Style="{DynamicResource LabelCustom}"/>

                                                    <Label Text="{Binding ArticleNumberPart}" Style="{DynamicResource LabelSecondaryCustom}"/>

                                                    <Label Text="{Binding CostPart}" Style="{DynamicResource LabelSecondaryCustom}"/>

                                                </VerticalStackLayout>
                                                <!--Данные авто-->

                                                <ImageButton Grid.Column="2"  Style="{DynamicResource ImageKebab}" Source="dots_image.png"  
                                                             Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CreateRepairViewModel}}, Path=ShowOptionsCommand}"
                                                             CommandParameter="{Binding .}"/>
                                                <!--Кебаб меню для карточки авто-->
                                            </Grid>

                                        </Border>
                                        <!--Обертка карточки-->
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>

                        </CollectionView>
                        <!--карточки-->

                    </VerticalStackLayout>
                    <!--замененный запчасти-->

                    <BoxView Style="{DynamicResource BoxViewCustom}"/>

                    <VerticalStackLayout Padding="15,10">
                        <Label Style="{DynamicResource LabelInfoForEntry}" Text="Выполнение работ"/>
                        <VerticalStackLayout RadioButtonGroup.GroupName="Job" RadioButtonGroup.SelectedValue="{Binding SelectedJob, Mode=TwoWay}">

                            <RadioButton  x:Name="ServiceButton" Content="Сервис" Value="Сервис" />

                            <RadioButton  Content="Самостоятельно" Value="Самостоятельно"/>

                            <Label Text="{Binding JobError}" Style="{DynamicResource LabelError}" IsVisible="{Binding IsJobError}"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                    <!--Где выполнялись работы-->

                    <BoxView Style="{DynamicResource BoxViewCustom}"/>

                    <VerticalStackLayout Padding="15,10">
                        <Label Text="{Binding CostText}" Style="{DynamicResource LabelInfoForEntry}"/>
                        <Entry Text="{Binding CostFilled}" Placeholder="Например 1000" Style="{DynamicResource EntryImput}" Keyboard="Numeric"/>
                        <Label Text="{Binding CostError}" Style="{DynamicResource LabelError}" IsVisible="{Binding IsCostError}"/>
                    </VerticalStackLayout>
                    <!--стоимость-->

                    <BoxView Style="{DynamicResource BoxViewCustom}"/>

                    <VerticalStackLayout Padding="15,10">
                        <Label Text="Описание выполненных работ" Style="{DynamicResource LabelInfoForEntry}"/>
                        <Editor Text="{Binding DescriptionFilled}" Placeholder="Что именно сделали..." 
                                AutoSize="TextChanges" Style="{DynamicResource EditorStandart}"/>
                    </VerticalStackLayout>
                    <!--описание выполненных работ-->

                    <VerticalStackLayout Padding="15,10">
                        <Label Text="Сюда можете прикрепить заказ наряды и чеки работы" Style="{DynamicResource LabelInfoForEntry}"/>
                        <Button Text="Прикрепить" Style="{DynamicResource ButtonCustomStandartRedMini}"
                                Command="{Binding AttachPhotoCommand}" Margin="0,10,0,30"/>

                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout BindableLayout.ItemsSource="{Binding AttachedPhotosRepairs}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border Padding="0" Margin="0,0,5,0" Style="{DynamicResource BorderForCardImage}">
                                            <Grid ColumnDefinitions="auto,auto" >
                                                <Image Source="{Binding .}" Aspect="AspectFill" HeightRequest="100" WidthRequest="100"/>
                                                <Button Text="X" TextColor="{DynamicResource ButtonPrimaryRed}" Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CreateRepairViewModel}}, Path=DeleteAttachPhotoCommand}"
                                                        CommandParameter="{Binding .}" Background="Transparent"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </ScrollView>
                    </VerticalStackLayout>
                    <!--фотографии чеков и ремонта-->

                    <BoxView Style="{DynamicResource BoxViewCustom}" IsVisible="{Binding Source={x:Reference ServiceButton},Path=IsChecked}"/>

                    <VerticalStackLayout Padding="15,10" IsVisible="{Binding Source={x:Reference ServiceButton},Path=IsChecked}">
                        <Label Text="Название сервиса" Style="{DynamicResource LabelInfoForEntry}"/>
                        <Entry Text="{Binding ServiceName}" Placeholder="Автосервис Игорек" Style="{DynamicResource EntryImput}"/>
                    </VerticalStackLayout>
                    <!-- Название сервиса -->

                    <BoxView Style="{DynamicResource BoxViewCustom}" IsVisible="{Binding Source={x:Reference ServiceButton},Path=IsChecked}"/>

                    <VerticalStackLayout Padding="15,10" IsVisible="{Binding Source={x:Reference ServiceButton},Path=IsChecked}">
                        <Label Text="Комментарий мастера" Style="{DynamicResource LabelInfoForEntry}"/>
                        <Editor Text="{Binding CommentMechanic}" Placeholder="Например: в след раз заменить ступицу." AutoSize="TextChanges" 
                                   Style="{DynamicResource EditorStandart}"/>
                    </VerticalStackLayout>
                    <!--комментайри мастера-->

                </VerticalStackLayout>
            </Border>
            <!--Основная информация-->

            <Label Text="{Binding StatusMessage}" Style="{DynamicResource LabelError}" HorizontalOptions="Center"/>

            <VerticalStackLayout Padding="20,10,20,40">
                <Button Text="{Binding ButtonName}" 
                        Style="{StaticResource ButtonCustomStandartRed}"
                        Command="{Binding ProcessingRepairCommand}"/>
            </VerticalStackLayout>
            <!--кнопка создания/редактирования-->

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>