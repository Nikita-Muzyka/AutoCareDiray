<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AutoCareDiray.View.RepairView.CreateRepairView"
             Style="{StaticResource CustomPage}">

    <Grid RowDefinitions="*,100">
        <ScrollView>

            <VerticalStackLayout Spacing="10">

                <Picker ItemsSource="{Binding RepairTypes}"
                        ItemDisplayBinding="{Binding TitleRepair}"
                        SelectedItem="{Binding SelectedRepairType}">
                    
                </Picker>
                
                <Border Style="{DynamicResource BorderForEntryImput}">
                    <Entry Style="{DynamicResource EntryImput}"
                           Placeholder="Интервал пробега"
                           Text="{Binding IntervalMileageFilled}"/>
                </Border>

                <!--<Label Text=""
                       Style="{DynamicResource LaberError}"/>-->

                <Border Style="{DynamicResource BorderForEntryImput}">
                    <VerticalStackLayout>
                        <Label Text="Выберите дату ремонта"
                               Style="{DynamicResource LabelInEntry}"/>
                        <DatePicker Format="d"
                                    Date ="{Binding DateRepairSelected}"
                                    MaximumDate="{Binding DateNow}">
                        </DatePicker>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{DynamicResource BorderForEntryImput}">
                    <VerticalStackLayout>
                        <Label Text="Следующая замена"
                Style="{DynamicResource LabelInEntry}"/>
                        <DatePicker Format="d"
                                    Date ="{Binding IntervalDateSelected}"
                                    MaximumDate="{Binding DateNow}">
                        </DatePicker>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{DynamicResource BorderForEntryImput}">
                    <Entry Style="{DynamicResource EntryImput}"
                           Placeholder="Текущий Пробег ТС"
                           Text="{Binding MileageFilled}"/>
                </Border>

                <Border Style="{DynamicResource BorderForEntryImput}">
                    <Entry Style="{DynamicResource EntryImput}"
                            Placeholder="Замененые запчасти"
                            Text="{Binding SparePartsFilled}"/>
                </Border>

                <Border Style="{DynamicResource BorderForEntryImput}">
                    <Entry Style="{DynamicResource EntryImput}"
                           Placeholder="Стоимость запчастей и ремонта"
                           Text="{Binding CostFilled}"/>
                </Border>

                <Border Style="{DynamicResource BorderForEntryImput}">
                    <Editor Style="{DynamicResource EditorStandart}"
                            Placeholder="Описание работ"
                            Text="{Binding DescriptionFilled}"/>
                </Border>

                <Label Text="{Binding StatusMessage}"
                       Style="{DynamicResource LaberError}"/>


                <Button Text="Create" 
                        Margin="0,10,0,0"
                        Style="{StaticResource ButtonCustomStandartRed}"
                        Command="{Binding CreateVehicleCommand}"/>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>