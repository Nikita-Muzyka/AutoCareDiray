<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AutoCareDiray.View.RepairView.ListRepairView"
             xmlns:vmRepair="clr-namespace:AutoCareDiray.ViewModels.RepairViewModel"
             Style="{DynamicResource CustomPage}">

    <ScrollView HorizontalScrollBarVisibility="Never"
            VerticalScrollBarVisibility="Never">
        <Grid RowDefinitions="80,*,100">
            <VerticalStackLayout Grid.Row="0">
                <Label Style="{DynamicResource LabelTextCustom}"
                       Text="Выбор авто"/>
                <Picker Style="{DynamicResource PickerStandart}" 
                        ItemsSource="{Binding Vehicles}"
                        ItemDisplayBinding="{Binding NameVehicle}"
                        SelectedItem="{Binding SelectedVehicle}">
                    
                </Picker>
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Row="1">

                <CollectionView ItemsSource="{Binding Repairs}"
                                SelectedItem="{Binding SelectedRepair}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command ="{Binding Source={RelativeSource AncestorType= {x:Type vmRepair:ListRepairViewModel}},
                                    Path=GoRepairCardCommand}"
                                                      CommandParameter="{Binding .}">
                                    </TapGestureRecognizer>
                                </Border.GestureRecognizers>
                                <VerticalStackLayout>
                                    <Grid ColumnDefinitions="100,auto,*">
                                        <Image Source="repair_image.png"
                                           HeightRequest="80"
                                           WidthRequest="60"/>
                                        <Label Text="Тип ремонта: " 
                                           FontSize="18"
                                           Margin="0,0,5,0"
                                           Grid.Column="1"
                                           HorizontalOptions="Start"
                                           VerticalOptions="Center"
                                           TextColor="{DynamicResource TextPrimaryRed}"
                                           FontFamily="{StaticResource RubikRegular}"/>

                                        <Label Text="{Binding RepairType.TitleRepair}" 
                                            FontSize="20"
                                            Grid.Column="2"
                                            HorizontalOptions="Start"
                                            VerticalOptions="Center"
                                            TextColor="{DynamicResource TextPrimaryRed}"
                                            FontFamily="{StaticResource RubikRegular}"/>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="2">
                <ImageButton HeightRequest="80"
                         WidthRequest="80"
                         Source="plus_icon.png"
                         Command="{Binding GoCreateRepairCommand}"/>

            </VerticalStackLayout>
        </Grid>
    </ScrollView>

</ContentPage>