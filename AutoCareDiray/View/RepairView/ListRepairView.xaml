<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AutoCareDiray.View.RepairView.ListRepairView"
             xmlns:vmRepair="clr-namespace:AutoCareDiray.Shared.ViewModels.RepairViewModel;assembly=AutoCareDiray.Shared"
             Style="{DynamicResource CustomPage}">


    <Grid RowDefinitions="80,*,100">
        <VerticalStackLayout Grid.Row="0">
            <Label Style="{DynamicResource LabelTextCustom}"
                       Text="Выбор авто"/>

            <Border Style="{DynamicResource BorderForEntryImput}">
                <Picker Style="{DynamicResource PickerStandart}" 
                            ItemsSource="{Binding Vehicles}"
                            ItemDisplayBinding="{Binding NameVehicle}"
                            SelectedItem="{Binding SelectedVehicle}">
                </Picker>
            </Border>

        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="1">

            <CollectionView ItemsSource="{Binding Repairs}"
                                SelectedItem="{Binding SelectedRepair}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command ="{Binding Source={RelativeSource AncestorType= {x:Type vmRepair:ListRepairViewModel}},
                                    Path=GoRepairCardCommand}"
                                                      CommandParameter="{Binding .}">
                                </TapGestureRecognizer>
                            </Border.GestureRecognizers>

                            <VerticalStackLayout HeightRequest="120">
                                <Grid ColumnDefinitions="100,*,auto,auto">
                                    <Image Source="repair_image.png"
                                                HeightRequest="50"
                                                WidthRequest="50"
                                                Grid.Column="0"/>
                                    <VerticalStackLayout Grid.Column="1">
                                        <Label Text="{Binding RepairType.TitleRepair}" 
                                               FontSize="20"
                                               Grid.Column="1"
                                               HorizontalOptions="Start"
                                               VerticalOptions="Center"
                                               TextColor="{DynamicResource TextPrimaryRed}"
                                               FontFamily="{StaticResource RubikRegular}"/>

                                        <Label Text="{Binding DateRepair,StringFormat='{}{0:d}'}"
                                                FontSize="20"
                                                Grid.Column="1"
                                                HorizontalOptions="Start"
                                                VerticalOptions="Center"
                                                TextColor="{DynamicResource TextPrimaryRed}"
                                                FontFamily="{StaticResource RubikRegular}"/>                    
                                    </VerticalStackLayout>
                                    <ImageButton Source="edit_image.png"
                                                     Grid.Column="2"
                                                     HeightRequest="30"
                                                     WidthRequest="30"
                                                     HorizontalOptions="End"
                                                     Margin="0,10,20,00"
                                                     Style="{StaticResource ImageButtonStandart}"
                                                     Command="{Binding Source={RelativeSource AncestorType={x:Type vmRepair:ListRepairViewModel}},Path=UpdateRepairCommand}"
                                                     CommandParameter="{Binding .}"/>
                                    <ImageButton Source="delete_image.png"
                                                     Grid.Column="3"
                                                     HeightRequest="30"
                                                     WidthRequest="30"
                                                     HorizontalOptions="End"
                                                     Margin="0,10,20,0"
                                                     Style="{StaticResource ImageButtonStandart}"
                                                     Command="{Binding Source={RelativeSource AncestorType={x:Type vmRepair:ListRepairViewModel}},Path=DeleteRepairCommand}"
                                                     CommandParameter="{Binding .}"/>
                                </Grid>
                                <Label Text="{Binding ProgressPercent}"
                                       TextColor="{DynamicResource TextPrimaryRed}"
                                       FontFamily="{StaticResource RubikRegular}"
                                       WidthRequest="300"/>
                                <ProgressBar ProgressColor="Red"
                                             Progress="{Binding ProgressMileage}"
                                             WidthRequest="300"/>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="2">
            <ImageButton HeightRequest="80"
                         WidthRequest="80"
                         Source="plus_icon.png"
                         Command="{Binding GoCreateRepairCommand}"/>

        </VerticalStackLayout>
    </Grid>
</ContentPage>