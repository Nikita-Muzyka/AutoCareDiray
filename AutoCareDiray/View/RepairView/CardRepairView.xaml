<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AutoCareDiray.View.RepairView.CardRepairView"
             Style="{DynamicResource CustomPage}">

    <Grid RowDefinitions="*,100"
          HorizontalOptions="Center">
        <ScrollView>

            <VerticalStackLayout Spacing="15">
                <!-- Поле name car -->

                <!-- LOGO -->
                <Image Style="{StaticResource ImageLogoApp}"/>

                <Grid ColumnDefinitions="150,auto"
                      HorizontalOptions="Center">
                    <Label Text="Пробег авто на момент созданя записи:"
                                   Style="{DynamicResource LaberInfo}"/>
                    <Label Grid.Column="1" 
                                   Text="{Binding RepairRespon.CurrentMileage}"
                                   Style="{DynamicResource LaberInfo}"/>
                </Grid>

                <Grid ColumnDefinitions="190,auto"
                      HorizontalOptions="Center">
                    <Label Text="Дата ремонта:"
                           Style="{DynamicResource LaberInfo}"/>
                     <Label Grid.Column="1" 
                            Text="{Binding RepairRespon.DateRepair }"
                            Style="{DynamicResource LaberInfo}"/>         
                </Grid>

                <Grid ColumnDefinitions="190,auto"
                      HorizontalOptions="Center">
                    <Label Text="Замененные запчасти:"
                    Style="{DynamicResource LaberInfo}"/>
                    <Label Grid.Column="1" 
                    Text="{Binding RepairRespon.SpareParts}"
                    Style="{DynamicResource LaberInfo}"/>
                </Grid>

                <Grid ColumnDefinitions="150,auto"
                      HorizontalOptions="Center">
                    <Label Text="Стоимость ремонта:"
                           Style="{DynamicResource LaberInfo}"/>
                    <Label Grid.Column="1" 
                           Text="{Binding RepairRespon.Cost}"
                           Style="{DynamicResource LaberInfo}"/>
                </Grid>

                <Grid ColumnDefinitions="150,auto"
                      HorizontalOptions="Center">
                    <Label Text="Описание работ:"
                           Style="{DynamicResource LaberInfo}"/>
                    <Label Grid.Column="1" 
                           Text="{Binding RepairRespon.Discription}"
                           Style="{DynamicResource LaberInfo}"/>
                </Grid>


             
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>