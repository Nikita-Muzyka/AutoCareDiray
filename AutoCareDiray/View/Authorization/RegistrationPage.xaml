<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AutoCareDiray.View.RegistrationPage"
             Style="{StaticResource CustomPage}">

    <!-- ГЛАВНЫЙ КОНТЕЙНЕР: Grid занимает весь экран -->
    <Grid RowDefinitions="250,auto">

        <!-- LOGO -->
        <Image Style="{StaticResource ImageLogoApp}"/>

        <ScrollView VerticalScrollBarVisibility="Never"
                  Grid.Row="1">

            <!-- Контент внутри скролла -->
            <VerticalStackLayout Spacing="5" 
                               Padding="30, 20, 30, 0">

                <!-- Логотип -->
                <Label HorizontalOptions="Center" 
                     FontSize="38"
                     Margin="0, 5, 0, 20">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="AutoCare " TextColor="{StaticResource PrimaryRed}" FontAttributes="Bold" FontFamily="{StaticResource RubikBold}"/>
                            <Span Text="Diary" TextColor="{StaticResource TextSecondary}" FontAttributes="Bold" FontFamily="{StaticResource RubikBold}"/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <!-- Поле Ник нейм -->
                <Border Style="{StaticResource BorderForEntryImput}">
                    <Grid ColumnDefinitions="40, *">
                        <Image Grid.Column="0" 
                             HeightRequest="35" 
                             WidthRequest="40"
                             HorizontalOptions="Start" 
                             Opacity="0.8"
                             Source="login_image.png"/>
                        <Entry Grid.Column="1"
                             Style="{StaticResource EntryImput}"
                             Placeholder="Ваше имя профиля"
                             HorizontalOptions="Start"
                             Text="{Binding NickName}"/>
                    </Grid>
                </Border>

                <!-- Поле email -->
                <Border Style="{StaticResource BorderForEntryImput}">
                    <Grid ColumnDefinitions="40, *">
                        <Image Grid.Column="0" 
                              HeightRequest="35" 
                              WidthRequest="40"
                              HorizontalOptions="Start" 
                              Opacity="0.8"
                              Source="login_image.png"/>
                                    <Entry Grid.Column="1"
                              Style="{StaticResource EntryImput}"
                              Placeholder="Ваша почта ( Email )"
                              HorizontalOptions="Start"
                              Text="{Binding Email}"/>      
                    </Grid>
                </Border>

                <!-- Поле Логин -->
                <Border Style="{StaticResource BorderForEntryImput}">
                    <Grid ColumnDefinitions="40, *">
                            <Image Grid.Column="0" 
                                  HeightRequest="35"                    
                                  WidthRequest="40"
                                  HorizontalOptions="Start" 
                                  Opacity="0.8"
                                  Source="login_image.png"/>
                                        <Entry Grid.Column="1"
                                  Style="{StaticResource EntryImput}"
                                  Placeholder="Логин"
                                  HorizontalOptions="Start"
                                  Text="{Binding Login}"/>      
                    </Grid>
                </Border>

                <!-- Поле пароль -->
                <Border Style="{StaticResource BorderForEntryImput}">
                    <Grid ColumnDefinitions="40, *">
                        <Image Grid.Column="0" 
                              HeightRequest="35"            
                              WidthRequest="40"
                              HorizontalOptions="Start" 
                              Opacity="0.8"
                              Source="login_image.png"/>
                                    <Entry Grid.Column="1"
                              Style="{StaticResource EntryImput}"
                              Placeholder="Ваш Пароль"
                              HorizontalOptions="Start"
                              Text="{Binding Password}"/>          
                    </Grid>
                </Border>

                <!-- Поле пароль повтор --><!--
                <Border Style="{StaticResource BorderForEntryImput}">
                    <Grid ColumnDefinitions="40, *">
                        <Image Grid.Column="0" 
                                HeightRequest="35" 
                                WidthRequest="40"
                                HorizontalOptions="Start" 
                                Opacity="0.8"
                                Source="login_image.png"/>
                        <Entry Grid.Column="1"
                               Style="{StaticResource EntryImput}"
                               Placeholder="Повторите пароль"
                               HorizontalOptions="Start"
                               Text="{Binding Login}"/>                
                    </Grid>
                </Border>-->

                <!-- Кнопки -->
                <Button Text="Регистрация"
                      Margin="0,10,0,0"
                      Style="{StaticResource ButtonCustomStandartRed}"
                      Command="{Binding RegistrationUserCommand}"
                      HeightRequest="50"
                      WidthRequest="300"/>

                <Button Text="Назад"
                      Margin="0,10,0,0"
                      Style="{StaticResource ButtonCustomStandartWhite}"
                      Command="{Binding BackCommand}"
                      HeightRequest="50"
                      WidthRequest="300"/>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>