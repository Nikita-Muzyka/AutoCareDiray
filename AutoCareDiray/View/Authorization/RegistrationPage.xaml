<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AutoCareDiray.View.RegistrationPage"
             Title="RegistrationPage">

    <Grid RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" 
        Text="{Binding Message}"
        HorizontalOptions="Center"
        VerticalOptions="End">
        </Label>

        <!--NickName-->
        <Label Grid.Row="1" 
               Text="{Binding NickNameError}"
               TextColor="Red"
               HorizontalOptions="Center"
               IsVisible="{Binding HasErrors}">
        </Label>
        <Entry Grid.Row="2"
               Text="{Binding NickName}"
               Placeholder="NickName"
               WidthRequest="200"
               HeightRequest="10">
        </Entry>
        
        <!--Email-->
        <Label Grid.Row="3" 
               Text="{Binding EmailError}"
               TextColor="Red"
               HorizontalOptions="Center"
               IsVisible="{Binding HasErrors}">
        </Label>
        <Entry Grid.Row="4"
               Text="{Binding Email}"
               Placeholder="Email"
               WidthRequest="200"
               HeightRequest="10">
        </Entry>
        
        <!--Login-->
        <Label Grid.Row="5" 
               Text="{Binding LoginError}"
               TextColor="Red"
               HorizontalOptions="Center"
               IsVisible="{Binding HasErrors}">
        </Label>
        <Entry Grid.Row="6"
               Text="{Binding Login}"
               Placeholder="Login"
               WidthRequest="200"
               HeightRequest="10">
        </Entry>

        <!--Password-->
        <Label Grid.Row="7" 
                Text="{Binding PasswordError}"
                TextColor="Red"
                HorizontalOptions="Center"
                IsVisible="{Binding HasErrors}">
        </Label>
        <Entry Grid.Row="8"
               Text="{Binding Password}"
               Placeholder="Password"
               WidthRequest="200"
               HeightRequest="10">
        </Entry>
         
        
        <!--Buttons-->
        <Button Grid.Row="9" 
                Text="Создать"
                WidthRequest="150"
                HeightRequest="10"
                IsEnabled="{Binding IsValid}"
                Command="{Binding CreateUserDTOCommand}">
        </Button>
        <Button Grid.Row="10" 
                Text="Назад"
                WidthRequest="150"
                HeightRequest="10"
                Command="{Binding CloseModalViewCommand}">
        </Button>

    </Grid>
</ContentPage>