<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AutoCareDiray.View.AuthorizationPage">

    <ScrollView>
        <Grid RowSpacing="0"
              HorizontalOptions="Center"
              VerticalOptions="Center"
              Padding="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="360"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header Section -->
            <VerticalStackLayout Grid.Row="0"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Spacing="10"
                                 Padding="0,0,0,30">

                <Image Source="main_image_app.png"
                       HeightRequest="200"
                       Aspect="AspectFit"
                       HorizontalOptions="Center"/>

                <Label Text="AutoCare Diary"
                       FontSize="32"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       TextColor="#E53935"
                       FontFamily="RubikBold"/>

            </VerticalStackLayout>

            <!-- Form Section -->
            <VerticalStackLayout Grid.Row="1"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Spacing="15"
                                 WidthRequest="320">

                <!-- Login Field -->
                <Border Style="{StaticResource BorderForEntryAuth}">
                    <Grid ColumnDefinitions="*, Auto"
                          VerticalOptions="Center">

                        <Entry Grid.Column="0"
                               Placeholder="Логин"
                               Text="{Binding Login}"
                               Style="{StaticResource EntryAuth}"
                               Margin="10,0,0,0"/>

                        <Label Grid.Column="1"
                               Text="📩"
                               FontSize="16"
                               HeightRequest="30"
                               WidthRequest="30"
                               VerticalOptions="Center"
                               HorizontalOptions="Start"
                               Margin="10,0,0,0"/>
                    </Grid>
                </Border>

                <!-- Password Field -->
                <Border Style="{StaticResource BorderForEntryAuth}">
                    <Grid ColumnDefinitions="*, Auto"
                          VerticalOptions="Center">

                        <Entry Grid.Column="0"
                               Placeholder="Пароль"
                               Text="{Binding Password}"
                               IsPassword="{Binding IsPassword}"
                               Style="{StaticResource EntryAuth}"
                               Margin="10,0,0,0"/>

                        <Label Grid.Column="1"
                               Text="🔒"
                               FontSize="16"
                               HeightRequest="30"
                               WidthRequest="30"
                               VerticalOptions="Center"
                               Margin="10,0,0,0"/>
                    </Grid>
                </Border>

                <!-- Options Section -->
                <Grid ColumnDefinitions="*, *"
                      HorizontalOptions="Center"
                      VerticalOptions="Center"
                      WidthRequest="250">

                    <!-- Show Password -->
                    <VerticalStackLayout Grid.Column="0"
                                         HorizontalOptions="Start"
                                         VerticalOptions="Center"
                                         Spacing="5">

                        <Label Text="Показать пароль"
                               FontSize="12"
                               Style="{StaticResource LabelTextCustom}"
                               WidthRequest="100"
                               HeightRequest="15"/>

                        <Switch IsToggled="{Binding IsTogglePasswordSwitch}"
                                Style="{StaticResource SwitchCustom}"
                                HorizontalOptions="Start"
                                WidthRequest="45"
                                HeightRequest="20"/>
                    </VerticalStackLayout>

                    <!-- Remember User -->
                    <VerticalStackLayout Grid.Column="1"
                                         HorizontalOptions="End"
                                         VerticalOptions="Center"
                                         Spacing="5">

                        <Label Text="Запомнить меня"
                               FontSize="12"
                               Style="{StaticResource LabelTextCustom}"
                               WidthRequest="100"
                               HeightRequest="15"/>

                        <Switch IsToggled="{Binding IsToggleSwitch}"
                                Style="{StaticResource SwitchCustom}"
                                HorizontalOptions="Start"
                                WidthRequest="45"
                                HeightRequest="20"/>
                    </VerticalStackLayout>

                </Grid>

            </VerticalStackLayout>

            <!-- Buttons Section -->
            <VerticalStackLayout Grid.Row="2"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Spacing="10"
                                 WidthRequest="320"
                                 Padding="0,20,0,0">

                <Button Text="Войти"
                        Command="{Binding LogInCommand}"
                        Style="{StaticResource ButtonAuth}"
                        HorizontalOptions="FillAndExpand"/>

                <Button Text="Зарегистрироваться"
                        Command="{Binding RegistrationCommand}"
                        Style="{StaticResource ButtonAuth}"
                        HorizontalOptions="FillAndExpand"/>

            </VerticalStackLayout>

            <!-- Status Message -->
            <VerticalStackLayout Grid.Row="3"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Padding="0,15,0,0">

                <Label Text="{Binding Text}"
                       Style="{StaticResource LabelAuthResponse}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"/>

            </VerticalStackLayout>

        </Grid>
    </ScrollView>

</ContentPage>