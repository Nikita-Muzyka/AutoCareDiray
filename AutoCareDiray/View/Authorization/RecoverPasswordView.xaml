<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AutoCareDiray.View.Authorization.RecoverPasswordView">
    
    <!-- ГЛАВНЫЙ КОНТЕЙНЕР: Grid занимает весь экран -->
    <Grid RowDefinitions="250,auto">

        <!-- LOGO -->
        <Image Style="{StaticResource ImageLogoApp}"/>

        <ScrollView VerticalScrollBarVisibility="Never"
                  Grid.Row="1">

            <!-- Контент внутри скролла -->
            <VerticalStackLayout Spacing="10" 
                               Padding="30, 20, 30, 0">

                <!-- Логотип -->
                <Label HorizontalOptions="Center" 
                     FontSize="38"
                     Margin="0, 5, 0, 20">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="AutoCare " TextColor="{StaticResource PrimaryRed}" FontAttributes="Bold" FontFamily="{StaticResource RubikBold}"/>
                            <Span Text="Diary" TextColor="{StaticResource TextSecondary}" FontAttributes="Bold" FontFamily="{StaticResource RubikBold}"/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <!-- Поле login -->
                <Border Style="{StaticResource BorderForEntryImput}">
                    <Grid ColumnDefinitions="40, *">
                        <Image Grid.Column="0" 
                             HeightRequest="35" 
                             WidthRequest="40"
                             HorizontalOptions="Start" 
                             Opacity="0.8"
                             Source="login_image.png"/>
                        <Entry Grid.Column="1"
                             Style="{StaticResource EntryImput}"
                             Placeholder="Введите свой Логин"
                             HorizontalOptions="Start"
                             Text="{Binding Login}"/>
                    </Grid>
                </Border>

                <!-- Поле Old Password -->
                <Border Style="{StaticResource BorderForEntryImput}">
                    <Grid ColumnDefinitions="40, *, 40">
                        <Image Grid.Column="0" 
                               HeightRequest="40" 
                               WidthRequest="40"
                               HorizontalOptions="Start" 
                               Opacity="0.8"
                               Source="password_image.png"/>
                        <ImageButton Grid.Column="2" 
                                     Style="{StaticResource ButtonShowPassword}"
                                     HeightRequest="40" 
                                     WidthRequest="50"
                                     HorizontalOptions="Center" 
                                     Opacity="0.5"
                                     Command="{Binding ShowPasswordCommand}"/>
                        <Entry Grid.Column="1" 
                               Style="{StaticResource EntryImput}"         
                               Placeholder="Введите старый Пароль"
                               IsPassword="{Binding IsOldPassword}"
                               WidthRequest="200"
                               HorizontalOptions="Start"
                               Text="{Binding OldPassword}"/> 
                    </Grid>
                </Border>

                <!-- Поле new Password -->
                <Border Style="{StaticResource BorderForEntryImput}">
                    <Grid ColumnDefinitions="40, *, 40">
                        <Image Grid.Column="0" 
                HeightRequest="40" 
                WidthRequest="40"
                HorizontalOptions="Start" 
                Opacity="0.8"
                Source="password_image.png"/>
                        <ImageButton Grid.Column="2" 
                      Style="{StaticResource ButtonShowPassword}"
                      HeightRequest="40" 
                      WidthRequest="50"
                      HorizontalOptions="Center" 
                      Opacity="0.5"
                      Command="{Binding ShowPasswordCommand}"/>
                        <Entry Grid.Column="1" 
                Style="{StaticResource EntryImput}"         
                Placeholder="Введите новый Пароль"
                IsPassword="{Binding IsNewPassword}"
                WidthRequest="200"
                HorizontalOptions="Start"
                Text="{Binding NewPassword}"/>
                    </Grid>
                </Border>

                <Label Text="{Binding PasswordErrors}"
                       TextColor="Red"/>


                <!-- Кнопки -->
                <Button Text="Изменить пароль"
                      Margin="0,10,0,0"
                      Style="{StaticResource ButtonCustomStandartRed}"
                      Command="{Binding ChangePasswordCommand}"
                        IsEnabled="{Binding IsEnableChangeButton}"
                      HeightRequest="50"
                      WidthRequest="300"/>

                <Button Text="Назад"      
                      Style="{StaticResource ButtonCustomStandartWhite}"
                      Command="{Binding BackCommand}"
                      HeightRequest="50"
                      WidthRequest="300"/>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>