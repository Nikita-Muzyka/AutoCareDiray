<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AutoCareDiray.View.SettingsView.SettingsView"
             Title="Настройки"
             Style="{DynamicResource CustomPage}">

    <ScrollView>
        <VerticalStackLayout Spacing="25" Padding="15,20,15,40">

            <Label Text="Настройки приложения" FontSize="22" Margin="0,0,10,5" Style="{DynamicResource LabelCustomMain}" HorizontalOptions="Center"/>

            <!-- ========================================== -->
            <!-- КАРТОЧКА 1: РАССТОЯНИЕ                     -->
            <!-- ========================================== -->
            <VerticalStackLayout Spacing="8">
                <Label Text="📏 Единицы расстояния" Style="{DynamicResource LabelInfoForEntry}" Margin="5,0"/>

                <Border Style="{DynamicResource BorderForEntryCard}" Padding="10,5">
                    <VerticalStackLayout RadioButtonGroup.GroupName="DistanceGroup" 
                                         RadioButtonGroup.SelectedValue="{Binding SelectedDistanceUnit, Mode=TwoWay}" Spacing="0">

                        <RadioButton Content="Километры (км)" Value="0" 
                                     ControlTemplate="{StaticResource CustomRadioTemplate}" Margin="0,5"/>

                        <BoxView Style="{DynamicResource BoxViewCustom}" Margin="10,0"/>

                        <RadioButton Content="Мили (mi)" Value="1" 
                                     ControlTemplate="{StaticResource CustomRadioTemplate}" Margin="0,5"/>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- ========================================== -->
            <!-- КАРТОЧКА 2: ОБЪЕМ ТОПЛИВА                  -->
            <!-- ========================================== -->
            <VerticalStackLayout Spacing="8">
                <Label Text="💧 Объем топлива" Style="{DynamicResource LabelInfoForEntry}" Margin="5,0"/>

                <Border Style="{DynamicResource BorderForEntryCard}" Padding="10,5">
                    <VerticalStackLayout RadioButtonGroup.GroupName="VolumeGroup" 
                                         RadioButtonGroup.SelectedValue="{Binding SelectedVolumeUnit, Mode=TwoWay}" Spacing="0">

                        <RadioButton Content="Литры (л)" Value="0" 
                                     ControlTemplate="{StaticResource CustomRadioTemplate}" Margin="0,5"/>

                        <BoxView Style="{DynamicResource BoxViewCustom}" Margin="10,0"/>

                        <RadioButton Content="Галлоны (gal)" Value="1" 
                                     ControlTemplate="{StaticResource CustomRadioTemplate}" Margin="0,5"/>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- ========================================== -->
            <!-- КАРТОЧКА 3: ВАЛЮТА                         -->
            <!-- ========================================== -->
            <VerticalStackLayout Spacing="8">
                <Label Text="💵 Валюта по умолчанию" Style="{DynamicResource LabelInfoForEntry}" Margin="5,0"/>

                <Border Style="{DynamicResource BorderForEntryCard}" Padding="10,5">
                    <VerticalStackLayout RadioButtonGroup.GroupName="MoneyGroup" 
                                         RadioButtonGroup.SelectedValue="{Binding SelectedMoneyUnit, Mode=TwoWay}" Spacing="0">

                        <RadioButton Content="Рубли (₽)" Value="RUB" 
                                     ControlTemplate="{StaticResource CustomRadioTemplate}" Margin="0,5"/>

                        <BoxView Style="{DynamicResource BoxViewCustom}" Margin="10,0"/>

                        <RadioButton Content="Доллары ($)" Value="USD" 
                                     ControlTemplate="{StaticResource CustomRadioTemplate}" Margin="0,5"/>

                        <BoxView Style="{DynamicResource BoxViewCustom}" Margin="10,0"/>

                        <RadioButton Content="Белорусский рубль (Br)" Value="BYR" 
                                     ControlTemplate="{StaticResource CustomRadioTemplate}" Margin="0,5"/>

                        <BoxView Style="{DynamicResource BoxViewCustom}" Margin="10,0"/>

                        <RadioButton Content="Евро (€)" Value="EUR" 
                                     ControlTemplate="{StaticResource CustomRadioTemplate}" Margin="0,5"/>

                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>