<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AutoCareDiray.View.UserSettingsPage"
             Title="UserSettingsPage">
    <StackLayout>
        <Label Text="NickName"/>
        <Entry IsEnabled="False" Text="{Binding NickName}"/>
        <Button Text="Изменить"/>
        
        <Label Text="Email"/>
        <Entry IsEnabled="False" Text="{Binding Email}"/>
        <Button Text="Изменить"/>

        <Button Text="Сохранить изменения"/>

        <Button Text="Выйти с профиля"
                Command="{Binding ExitProfilCommand}"
                BackgroundColor="Red"/>
    </StackLayout>
</ContentPage>