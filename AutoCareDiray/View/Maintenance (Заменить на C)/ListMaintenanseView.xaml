<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AutoCareDiray.View.Maintenanse.ListMaintenanseView"
             Title="ListMaintenanseView">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="100"/>
        </Grid.ColumnDefinitions>

        <StackLayout Grid.Row="0"
                  Grid.Column="0">
            <ListView ItemsSource="{Binding ListMaintenanse}"
                   SelectedItem="{Binding SelectedCar}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <StackLayout Padding="10">
                                <Label Text="{Binding ServiceDate}" 
                            FontSize="16" 
                            TextColor="Black"/>
                                <!-- Добавьте другие свойства Car -->
                                <Label Text="{Binding ServiceType}" 
                            FontSize="14" 
                            TextColor="Gray"/>
                                <Label Text="{Binding Description}" 
                            FontSize="14" 
                            TextColor="Gray"/>
                            </StackLayout>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackLayout>

        <StackLayout Grid.Row="1"
                  Grid.Column="1">
            <Button Text="Create Car"
                 Command="{Binding GoCreateCarCommand}"/>

            <Button Text="Select"
                 Command="{Binding GoCarCardCommand}"/>
            <Label Text="{Binding Errors}"/>
        </StackLayout>
    </Grid>
</ContentPage>