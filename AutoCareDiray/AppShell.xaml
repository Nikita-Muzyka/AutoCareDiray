<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AutoCareDiray.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:AutoCareDiray.View"
    Title="AutoCareDiray">

    <Tab Title="Авторизация"
         Route="AuthorizationPage">
        <ShellContent ContentTemplate="{DataTemplate local:AuthorizationPage}"/>
    </Tab>

    <TabBar>
        <Tab Title="Главная"
             Route="MainPage">
            <ShellContent ContentTemplate="{DataTemplate local:MainPage}"/>
        </Tab>

        <Tab Title="Авто"
             Route="ListCars">
            <ShellContent ContentTemplate="{DataTemplate local:ListCars}"/>
        </Tab>
    </TabBar>


</Shell>
