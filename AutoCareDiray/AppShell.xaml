<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AutoCareDiray.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:AutoCareDiray.View"
    Title="AutoCareDiray"
    Style="{StaticResource CustomTabBar}">


    
        <ShellContent 
         Route="AuthorizationPage"
         ContentTemplate="{DataTemplate local:AuthorizationPage}"/>


    <TabBar Route="Main">
        <Tab Title="Главная"
             Route="MainPage">
            <ShellContent ContentTemplate="{DataTemplate local:MainPage}"/>
        </Tab>

        <Tab Title="Авто"
             Route="ListCars">
            <ShellContent ContentTemplate="{DataTemplate local:ListCars}"/>
        </Tab>

        <Tab Title="Профиль"
      Route="UserSettings">
            <ShellContent ContentTemplate="{DataTemplate local:UserSettingsPage}"/>
        </Tab>
    </TabBar>
</Shell>
