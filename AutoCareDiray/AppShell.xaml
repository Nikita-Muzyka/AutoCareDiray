<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AutoCareDiray.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vehicleView="clr-namespace:AutoCareDiray.View.VehicleView"
    xmlns:repairView="clr-namespace:AutoCareDiray.View.RepairView"
    xmlns:journalView="clr-namespace:AutoCareDiray.View.JournalEventView"
    Title="AutoCareDiray"
    Style="{StaticResource CustomTabBar}">


    <TabBar>

        <Tab Title="Авто"
             Route="ListVehicle">
            <ShellContent ContentTemplate="{DataTemplate vehicleView:ListVehicleView}"/>
        </Tab>

        <Tab Title="Ремонт"
             Route="ListRepair">
            <ShellContent ContentTemplate="{DataTemplate repairView:ListRepairView}"/>
        </Tab>

        <Tab Title="Журнал Событий"
             Route="ListRepair">
            <ShellContent ContentTemplate="{DataTemplate journalView:JournalEventView}"/>
        </Tab>

    </TabBar>
    
    
</Shell>
