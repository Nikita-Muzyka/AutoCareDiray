<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AutoCareDiray.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vehicleView="clr-namespace:AutoCareDiray.View.VehicleView"
    xmlns:settings="clr-namespace:AutoCareDiray.View.SettingsView"
    xmlns:journalView="clr-namespace:AutoCareDiray.View.JournalEventView"
    Title="AutoCareDiray"
    Style="{StaticResource CustomTabBar}">


    <TabBar>

        <Tab Title="Авто"
             Route="ListVehicle"
             Icon="car_icon.png">
            <ShellContent ContentTemplate="{DataTemplate vehicleView:ListVehicleView}"/>
        </Tab>

        <Tab Title="Журнал Событий"
             Route="JournalEvent"
             Icon="journalevent_icon.png">
            <ShellContent ContentTemplate="{DataTemplate journalView:JournalEventView}"/>
        </Tab>

        <Tab Title="Настройки"
             Route="Settings"
             Icon="settings_icon.png">
            <ShellContent ContentTemplate="{DataTemplate settings:SettingsView}"/>
        </Tab>

    </TabBar>
    
    
</Shell>
