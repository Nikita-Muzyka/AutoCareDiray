<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AutoCareDiray.Resources.Styles.Vehicle.CardVehicle">

    <!--Label Текст для отображения названия информации для карточки инфомации авто-->
    <Style TargetType="Label" x:Key="LabelTitleInfo">
        <Setter Property="FontFamily" Value="{StaticResource MontserratMedium}"/>
        <Setter Property="CharacterSpacing" Value="1.1"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="TextColor" Value="{DynamicResource PrimarySecondary}"/>
    </Style>

    <!--HorizontalStackLayout для информации авто-->
    <Style TargetType="HorizontalStackLayout" x:Key="HSLCardInfo">
        <Setter Property="Spacing" Value="5"/>
    </Style>

    <!--BoxView для отступов информации авто-->
    <Style TargetType="BoxView" x:Key="BoxViewCustom">
        <Setter Property="Margin" Value="15,0,0,0"/>
        <Setter Property="HeightRequest" Value="1"/>
        <Setter Property="WidthRequest" Value="1000"/>
        <Setter Property="Color" Value="{DynamicResource BoxViewColor}"/>
    </Style>



</ResourceDictionary>