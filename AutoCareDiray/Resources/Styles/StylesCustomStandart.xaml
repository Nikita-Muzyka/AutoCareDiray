<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    x:Class="AutoCareDiray.Resources.Styles.StylesCustomStandart"
                    xmlns:behaviors="clr-namespace:AutoCareDiray.Controls.Behaviors">



    <Shadow x:Key="ShadowRedLightForBorder" Brush="{DynamicResource ShadowRedLight}" Opacity="0.2" Offset="0,1" Radius="7"/>
    <Shadow x:Key="ShadowRedLightForGrid" Brush="{DynamicResource ShadowRedLight}" Opacity="0.5" Offset="0,2" Radius="5"/>
    <Shadow x:Key="ShadowForBorderCardEntry" Brush="{DynamicResource ShadowRedLight}" Opacity="0.15" Offset="0,4" Radius="10"/>
    <Shadow x:Key="ShadowDisableForButton" Brush="{DynamicResource ShadowDisableButton}" Opacity="0.8" Offset="0,3" Radius="10"/>

    <Shadow x:Key="ShadowGreenLightForButton" Brush="{DynamicResource ShadowGreenLight}" Opacity="0.4" Offset="0,4" Radius="10"/>
    <Shadow x:Key="ShadowGoldForBorderPhoto" Brush="{DynamicResource ShadowGoldLight}" Opacity="0.5" Offset="0,4" Radius="10"/>
    <Shadow x:Key="ShadowBlackForBorderCard" Brush="{DynamicResource ShadowBlack}" Opacity="0.05" Offset="0,4" Radius="10"/>

    <!-- Image Лого картинка программы-->
    <Style TargetType="Image" x:Key="ImageLogoApp">
        <Setter Property="HeightRequest" Value="300" />
        <Setter Property="WidthRequest" Value="500" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Start" />
        <Setter Property="Aspect" Value="AspectFill" />
        <Setter Property="Source" Value="car_side_view.png" />
    </Style>

    <!--Image Лого картинка для списка авто-->
    <Style TargetType="Image" x:Key="ImageForList">
        <Setter Property="HeightRequest" Value="30" />
        <Setter Property="WidthRequest" Value="30" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="Aspect" Value="AspectFill" />
    </Style>

    <!--Image для картинок на карточке информации -->
    <Style TargetType="Image" x:Key="ImageForCardInfo">
        <Setter Property="HeightRequest" Value="30" />
        <Setter Property="WidthRequest" Value="30" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="Margin" Value="0,0,5,0" />
        <Setter Property="Aspect" Value="Fill" />
    </Style>



    <!--ImageButton кнопка картинка для списка Кебаб меню (удалить редактировать)-->
    <Style TargetType="ImageButton" x:Key="ImageKebab">
        <Setter Property="HeightRequest" Value="30" />
        <Setter Property="WidthRequest" Value="30" />
        <Setter Property="MinimumWidthRequest" Value="10" />
        <Setter Property="MinimumHeightRequest" Value="10" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="Aspect" Value="AspectFill" />
        <Style.Behaviors>
            <behaviors:ImageButtonBounceBehavior/>
        </Style.Behaviors>
    </Style>

    <!--ImageButton стандартный-->
    <Style TargetType="ImageButton" x:Key="ImageButtonStandart">
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="MinimumHeightRequest" Value="10"/>
        <Setter Property="MinimumWidthRequest" Value="10"/>
    </Style>



    <!--Button  Create + -->
    <Style TargetType="Button" x:Key="ButtonCreate">
        <Setter Property="FontSize" Value="32"/>
        <Setter Property="FontFamily" Value="{StaticResource MontserratBold}"/>
        <Setter Property="MinimumHeightRequest" Value="30"/>
        <Setter Property="MinimumWidthRequest" Value="30"/>
        <Setter Property="WidthRequest" Value="70"/>
        <Setter Property="HeightRequest" Value="70"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="CornerRadius" Value="40"/>
        <Setter Property="Text" Value="+"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{DynamicResource ButtonTextPrimaryWhite}"/>
                            <Setter Property="BackgroundColor" Value="{DynamicResource ButtonPrimaryRed}" />
                            <Setter Property="Shadow" Value="{DynamicResource ShadowRedLightForButton}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{DynamicResource ButtonTextDisable}" />
                            <Setter Property="BackgroundColor" Value="{DynamicResource ButtonDisable}" />
                            <Setter Property="Shadow" Value="{DynamicResource ShadowDisableForButton}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver" />
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
        <Style.Behaviors>
            <behaviors:ButtonBounceBehavior/>
        </Style.Behaviors>
    </Style>

    <!-- Button стандартная зеленая-->
    <Style TargetType="Button" x:Key="ButtonCustomStandart">
        <Setter Property="CharacterSpacing" Value="1.1"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="Padding" Value="5,5"/>
        <Setter Property="FontFamily" Value="{StaticResource MontserratBold}"/>
        <Setter Property="MinimumHeightRequest" Value="30"/>
        <Setter Property="MinimumWidthRequest" Value="30"/>
        <Setter Property="HeightRequest" Value="50"/>
        <Setter Property="WidthRequest" Value="300"/>
        <Setter Property="Shadow" Value="{DynamicResource ShadowGreenLightForButton}"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{DynamicResource ButtonTextPrimaryWhite}"/>
                            <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryGreen}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{DynamicResource ButtonTextPrimaryWhite}"/>
                            <Setter Property="BackgroundColor" Value="{DynamicResource ButtonPressed}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={DynamicResource ButtonTextDisable}, Dark={DynamicResource ButtonTextDisable}}" />
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={DynamicResource ButtonDisable}, Dark={DynamicResource ButtonDisable}}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver" />
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
        <Style.Behaviors>
            <behaviors:ButtonBounceBehavior/>
        </Style.Behaviors>
    </Style>

    <!-- Button стандартная зеленая маленькая -->
    <Style TargetType="Button" x:Key="ButtonCustomStandartRedMini">
        <Setter Property="CharacterSpacing" Value="1.2"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="Padding" Value="5,5"/>
        <Setter Property="FontFamily" Value="{StaticResource RubikRegular}"/>
        <Setter Property="MinimumHeightRequest" Value="30"/>
        <Setter Property="MinimumWidthRequest" Value="30"/>
        <Setter Property="HeightRequest" Value="35"/>
        <Setter Property="WidthRequest" Value="200"/>
        <Setter Property="Shadow" Value="{DynamicResource ShadowRedLightForButton}"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{DynamicResource ButtonTextPrimaryWhite}"/>
                            <Setter Property="BackgroundColor" Value="{DynamicResource ButtonPrimaryRed}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{DynamicResource ButtonTextPrimaryWhite}"/>
                            <Setter Property="BackgroundColor" Value="{DynamicResource ButtonPressed}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={DynamicResource ButtonTextDisable}, Dark={DynamicResource ButtonTextDisable}}" />
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={DynamicResource ButtonDisable}, Dark={DynamicResource ButtonDisable}}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver" />
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
        <Style.Behaviors>
            <behaviors:ButtonBounceBehavior/>
        </Style.Behaviors>
    </Style>

