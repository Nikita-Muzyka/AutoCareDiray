<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AutoCareDiray.Resources.Styles.StylesCustomStandart">


    <!--Лого картинка программы-->
    <Style TargetType="Image" x:Key="ImageLogoApp">
        <Setter Property="HeightRequest" Value="300" />
        <Setter Property="WidthRequest" Value="500" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Start" />
        <Setter Property="Aspect" Value="AspectFill" />
        <Setter Property="Source" Value="car_side_view.png" />
    </Style>

    <Style TargetType="Label" x:Key="LabelLogo">
        <Setter Property="FontSize" Value="38"/>
        <Setter Property="HorizontalOptions" Value="Center"/>
        <Setter Property="Margin" Value="0, 5, 0, 20"/>
        <Setter Property="FormattedText">
            <FormattedString>
                <Span Text="AutoCare " 
                      TextColor="{StaticResource PrimaryRed}" 
                      FontAttributes="Bold" 
                      FontFamily="{StaticResource RubikBold}"/>
                <Span Text="Diary" 
                      TextColor="{StaticResource TextSecondary}" 
                      FontAttributes="Bold" 
                      FontFamily="{StaticResource RubikBold}"/>
            </FormattedString>
        </Setter>
    </Style>

    <!--Ошибки-->
    <Style TargetType="Label" x:Key="LaberError">
        <Setter Property="FontFamily" Value="{StaticResource RubikRegular}"/>
        <Setter Property="CharacterSpacing" Value="1.2"/>
        <Setter Property="HorizontalOptions" Value="Center"/>
        <Setter Property="HeightRequest" Value="16"/>
        <Setter Property="TextColor" Value="{DynamicResource TextError}"/>
    </Style>

    <!--Для информации -->
    <Style TargetType="Label" x:Key="LaberInfo">
        <Setter Property="FontFamily" Value="{StaticResource RubikRegular}"/>
        <Setter Property="CharacterSpacing" Value="1.2"/>
        <Setter Property="HorizontalOptions" Value="Center"/>
        <Setter Property="VerticalOptions" Value="Center"/>
        <Setter Property="TextColor" Value="{DynamicResource TextError}"/>
        <Setter Property="HeightRequest" Value="40"/>
        <Setter Property="WidthRequest" Value="120"/>
        <Setter Property="FontSize" Value="16"/>
    </Style>


    <!--Для информации -->
    <Style TargetType="Label" x:Key="LaberInfoMini">
        <Setter Property="FontFamily" Value="{StaticResource RubikRegular}"/>
        <Setter Property="CharacterSpacing" Value="1.2"/>
        <Setter Property="HorizontalOptions" Value="Center"/>
        <Setter Property="VerticalOptions" Value="Center"/>
        <Setter Property="TextColor" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="HeightRequest" Value="30"/>
        <Setter Property="WidthRequest" Value="300"/>
        <Setter Property="FontSize" Value="10"/>
    </Style>

    <!--Border для полей ввода под EntryImput-->
    <Style TargetType="Border" x:Key="BorderForEntryImput">
        <Setter Property="Stroke" Value="{AppThemeBinding Light={DynamicResource InputBorder}, Dark={DynamicResource InputBorder}}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 15"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="WidthRequest" Value="300"/>
    </Style>

    <!--Entry для ввода данных стандартный--> 
    <Style TargetType="Entry" x:Key="EntryImput">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={DynamicResource PrimaryBlack}, Dark={DynamicResource PrimaryWhite}}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={DynamicResource InputPlaceholder}, Dark={DynamicResource InputPlaceholder}}" />
        <Setter Property="MinimumHeightRequest" Value="50"/>
        <Setter Property="MinimumWidthRequest" Value="50"/>
        <Setter Property="Margin" Value="10,0,0,0"/>
        <Setter Property="WidthRequest" Value="300"/>
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="FontFamily" Value="{StaticResource RubikRegular}"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{DynamicResource Gray500}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Picker" x:Key="PickerStandart">
        <Setter Property="VerticalOptions" Value="Center"/>
        <Setter Property="HorizontalOptions" Value="Center"/>
        <Setter Property="HeightRequest" Value="50"/>
        <Setter Property="WidthRequest" Value="300"/>
        <Setter Property="CharacterSpacing" Value="1.2"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="{StaticResource RubikRegular}"/>
    </Style>

    <Style TargetType="Label" x:Key="LabelInEntry">
        <Setter Property="FontFamily" Value="{StaticResource RubikRegular}"/>
        <Setter Property="CharacterSpacing" Value="1.2"/>
        <Setter Property="Margin" Value="10,0,0,0"/>
    </Style>


    <!--Кнопка стандартная красная-->
    <Style TargetType="Button" x:Key="ButtonCustomStandartRed">
        <Setter Property="TextColor" Value="{DynamicResource ButtonTextPrimaryWhite}"/>
        <Setter Property="BackgroundColor" Value="{DynamicResource ButtonPrimaryRed}" />
        <Setter Property="CharacterSpacing" Value="1.2"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="BorderWidth" Value="0"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="Padding" Value="5,5"/>
        <Setter Property="FontFamily" Value="{StaticResource RubikRegular}"/>
        <Setter Property="MinimumHeightRequest" Value="30"/>
        <Setter Property="MinimumWidthRequest" Value="30"/>
        <Setter Property="HeightRequest" Value="50"/>
        <Setter Property="WidthRequest" Value="300"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={DynamicResource Gray950}, Dark={DynamicResource Gray200}}" />
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={DynamicResource ButtonSecondary}, Dark={DynamicResource ButtonSecondary}}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver" />
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!--Кнопка стандартная белая -->
    <Style TargetType="Button" x:Key="ButtonCustomStandartWhite">
        <Setter Property="TextColor" Value="{DynamicResource ButtonTextPrimaryBlack}"/>
        <Setter Property="BackgroundColor" Value="{DynamicResource ButtonPrimaryGray}" />
        <Setter Property="CharacterSpacing" Value="1.2"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="BorderWidth" Value="1"/>
        <Setter Property="BorderColor" Value="Black"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="Padding" Value="5,5"/>
        <Setter Property="FontFamily" Value="{StaticResource RubikRegular}"/>
        <Setter Property="MinimumHeightRequest" Value="30"/>
        <Setter Property="MinimumWidthRequest" Value="30"/>
        <Setter Property="HeightRequest" Value="50"/>
        <Setter Property="WidthRequest" Value="300"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={DynamicResource Gray950}, Dark={DynamicResource Gray200}}" />
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={DynamicResource ButtonSecondary}, Dark={DynamicResource ButtonSecondary}}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver" />
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    
    <Style TargetType="Button" x:Key="ButtonCustomWarning">
        <Setter Property="TextColor" Value="{StaticResource ButtonTextSecondary}"/>
        <Setter Property="BackgroundColor" Value="{StaticResource ButtonSecondary}" />
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="BorderWidth" Value="0"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="Padding" Value="5,5"/>
        <Setter Property="FontFamily" Value="{StaticResource RubikRegular}"/>
        <Setter Property="MinimumHeightRequest" Value="30"/>
        <Setter Property="MinimumWidthRequest" Value="30"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray950}, Dark={StaticResource Gray200}}" />
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ButtonSecondary}, Dark={StaticResource ButtonSecondary}}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver" />
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="ImageButton" x:Key="ImageButtonStandart">
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="MinimumHeightRequest" Value="10"/>
        <Setter Property="MinimumWidthRequest" Value="10"/>
    </Style>

    <Style TargetType="CheckBox" x:Key="CheckBoxStandart">
        <Setter Property="Color" Value="{DynamicResource PrimaryRed}"/>
    </Style>

    <Style TargetType="Label" x:Key="LabelTextCustom">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryBlack}, Dark={StaticResource PrimaryWhite}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="FontFamily" Value="{StaticResource RubikRegular}"/>
        <Setter Property="CharacterSpacing" Value="1.2"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Editor" x:Key="EditorStandart">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryBlack}, Dark={StaticResource PrimaryWhite}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="FontFamily" Value="{StaticResource RubikRegular}"/>
        <Setter Property="CharacterSpacing" Value="1.2"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="HeightRequest" Value="150"/>
        <Setter Property="WidthRequest" Value="300"/>
    </Style>



    <Style TargetType="Shell" x:Key="CustomTabBar">
        <Setter Property="Shell.BackgroundColor" Value="{AppThemeBinding Light={StaticResource PrimaryWhite}, Dark={StaticResource PrimaryBlack}}" />
        <Setter Property="Shell.ForegroundColor" Value="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource SecondaryDarkText}}" />
        <Setter Property="Shell.TitleColor" Value="{AppThemeBinding Light={StaticResource PrimaryRed}, Dark={StaticResource PrimaryRed}}" />
        <Setter Property="Shell.DisabledColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray950}}" />
        <Setter Property="Shell.UnselectedColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray200}}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{AppThemeBinding Light={StaticResource TabBar}, Dark={StaticResource TabBar}}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{AppThemeBinding Light={StaticResource Magenta}, Dark={StaticResource White}}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{AppThemeBinding Light={StaticResource PrimaryRed}, Dark={StaticResource PrimaryRed}}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{AppThemeBinding Light={StaticResource PrimaryBlack}, Dark={StaticResource PrimaryWhite}}" />
    </Style>



    <Style TargetType="Page" ApplyToDerivedTypes="True" x:Key="CustomPage">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PrimaryWhite}, Dark={StaticResource PrimaryBlack}}" />
    </Style>
</ResourceDictionary>