<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AutoCareDiray.Resources.Styles.Journal.JournalStyle">

    <!--Picker Custom-->
    <Style TargetType="Picker" x:Key="PickerJournal">
        <Setter Property="VerticalOptions" Value="Center"/>
        <Setter Property="CharacterSpacing" Value="1.2"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontFamily" Value="{StaticResource MontserratMedium}"/>
        <Setter Property="HorizontalOptions" Value="Center"/>
        <Setter Property="HorizontalOptions" Value="Center"/>
        <Setter Property="HorizontalTextAlignment" Value="Center"/>
        <Setter Property="HeightRequest" Value="20"/>
    </Style>

    <!--Border для Picker journal-->
    <Style TargetType="Border" x:Key="BorderPickerJournal">
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="BackgroundColor" Value="{DynamicResource Background}" />
        <Setter Property="Stroke" Value="{DynamicResource PrimaryGreen}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="Shadow" Value="{StaticResource ShadowGreenLightForBorder}"/>
        <Setter Property="HeightRequest" Value="40"/>
    </Style>

</ResourceDictionary>