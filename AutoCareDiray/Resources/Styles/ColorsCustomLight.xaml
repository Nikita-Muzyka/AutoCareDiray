<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    x:Class="AutoCareDiray.Resources.Styles.ColorsCustomLight">

    <!-- ===== ОСНОВНЫЕ ЦВЕТА ===== -->
    <Color x:Key="PrimaryGreen">#00823f</Color>
    <Color x:Key="PrimaryGold">#C8A45D</Color>
    <Color x:Key="PrimaryRed">#E53935</Color>
    <Color x:Key="PrimarySecondary">#757575</Color>
    <Color x:Key="PrimaryWhite">#f0f0f0</Color>
    <Color x:Key="PrimaryBlack">#212121</Color>

    <!-- ===== ФОН И ПОВЕРХНОСТИ ===== -->
    <Color x:Key="Background">#FFFFFF</Color>
    <Color x:Key="CardBorder">#BABABA</Color>
    <Color x:Key="BorderStroke">#777777</Color>
    <Color x:Key="BackgroundGray">#acb2b0</Color>
    <Color x:Key="BoxViewColor">#E0E0E0</Color>

    <!-- ===== Тени ===== -->

    <Color x:Key="ShadowDisableButton">#383838</Color>
    <Color x:Key="ShadowBlack">#000000</Color>
    <Color x:Key="ShadowGoldLight">#C8A45D</Color>
    <Color x:Key="ShadowGreenLight">#00823f</Color>
    <Color x:Key="ShadowRedLight">#E45752</Color>

    <!-- ===== ТЕКСТ ===== -->
    <Color x:Key="TextBlack">#212121</Color>
    <Color x:Key="TextError">#E53935</Color>

    <!-- ===== КНОПКИ ===== -->
    <Color x:Key="ButtonDisable">#807F7F</Color>
    <Color x:Key="ButtonTextPrimaryWhite">#FFFFFF</Color>
    <Color x:Key="ButtonTextPrimaryBlack">#000000</Color>
    <Color x:Key="ButtonTextDisable">#FFFFFF</Color>
    <Color x:Key="ButtonPressed">#00be5c</Color>


    <!-- ===== ПОЛЯ ВВОДА ===== -->
    <Color x:Key="InputBackground">#FFFFFF</Color>
    <Color x:Key="InputBorder">#E0E0E0</Color>
    <Color x:Key="InputBorderFocused">#E53935</Color>
    <Color x:Key="InputPlaceholder">#9E9E9E</Color>

    <!-- ===== НАВИГАЦИЯ ===== -->
    <Color x:Key="NavigationBar">#E53935</Color>
    <Color x:Key="NavigationText">#FFFFFF</Color>
    <Color x:Key="TabBar">#FFFFFF</Color>
    <Color x:Key="TabSelected">#E53935</Color>
    <Color x:Key="TabUnselected">#9E9E9E</Color>

    <!-- ===== СТАТУСЫ АВТО ===== -->
    <Color x:Key="StatusCompleted">#4CAF50</Color>
    <Color x:Key="StatusPending">#FF9800</Color>
    <Color x:Key="StatusOverdue">#F44336</Color>



</ResourceDictionary>